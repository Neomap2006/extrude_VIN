@section Scripts {
    <script src="~/lib/offline-cdn/sweetalert2.all.min.js"></script>
    <script src="~/lib/offline-cdn/html5-qrcode.min.js"></script>
    <script>
        // === SESSION CONTEXT (injected from client-side _Layout.cshtml) ===
        // window.SESSION_MACHINE_NAME is set in _Layout.cshtml

        let html5QrCode;

        async function openScanner(targetId) {
            Swal.fire({
                title: 'SCANNING MATERIAL LOT',
                html: `
                    <div id="reader-container" style="width: 100%; min-height: 250px; background: #000; border-radius: 8px; overflow: hidden; border: 2px solid #0ea5e9;">
                        <div id="reader"></div>
                    </div>
                    <div class="mt-3 text-info-glow small fw-bold tracking-widest">POSITION BARCODE WITHIN FRAME</div>
                `,
                background: '#020617',
                color: '#0ea5e9',
                showConfirmButton: false,
                showCloseButton: true,
                width: '90%',
                didOpen: () => {
                    const config = { fps: 10, qrbox: { width: 250, height: 150 } };
                    html5QrCode = new Html5Qrcode("reader");
                    
                    html5QrCode.start(
                        { facingMode: "environment" }, 
                        config,
                        (decodedText) => {
                            // On Success
                            document.getElementById(targetId).value = decodedText;
                            document.getElementById(targetId).parentElement.classList.add('glow-success');
                            setTimeout(() => document.getElementById(targetId).parentElement.classList.remove('glow-success'), 2000);
                            
                            html5QrCode.stop().then(() => {
                                Swal.close();
                                // Optional haptic feedback
                                if (window.navigator.vibrate) window.navigator.vibrate(100);
                            });
                        },
                        (errorMessage) => { /* scanning... */ }
                    ).catch(err => {
                        console.error(err);
                        document.getElementById('reader').innerHTML = `<div class="p-4 text-danger small">CAMERA ERROR: ${err}</div>`;
                    });
                },
                willClose: () => {
                    if (html5QrCode && html5QrCode.isScanning) {
                        html5QrCode.stop();
                    }
                }
            });
        }

        // --- SPS SYNC LOGIC ---
        async function startSpsScanner() {
            Swal.fire({
                title: '<div class="text-primary-glow font-monospace small">SPS OPTICAL SCANNER</div>',
                html: `
                    <div id="sps-reader-container" style="width: 100%; min-height: 250px; background: #000; border-radius: 8px; overflow: hidden; border: 2px solid #0ea5e9;">
                        <div id="sps-reader"></div>
                    </div>
                `,
                background: '#020617',
                showConfirmButton: false,
                showCloseButton: true,
                didOpen: () => {
                    const scanQrCode = new Html5Qrcode("sps-reader");
                    const config = { fps: 10, qrbox: { width: 250, height: 250 } };
                    scanQrCode.start({ facingMode: "environment" }, config, async (decodedText) => {
                        await scanQrCode.stop();
                        Swal.close();
                        fetchSpsByItem(decodedText);
                    });
                }
            });
        }



        function clearActualInputs() {
            // Clear all operator-entered "Actual" fields (not SPS standard fields)
            const actualIds = [
                'InnerMaterialActual','MiddleMaterialActual','OuterMaterialActual','YarnActual',
                'DAI_Awal','DAI_Akhir','DAC_Awal','DAC_Akhir',
                'DRAI_Awal','DRAI_Akhir','DRAC_Awal','DRAC_Akhir',
                'EmbossMarkContent','EmbossMarkDate',
                'WasteInner','WasteOuter','WasteYarn','WasteTotal',
                'TotalLength','TotalWeight','Remarks'
            ];
            actualIds.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });

            // Clear all radio buttons
            document.querySelectorAll('#mainFormContainer input[type="radio"]').forEach(r => r.checked = false);

            // Clear all checkboxes
            document.querySelectorAll('#mainFormContainer input[type="checkbox"]').forEach(c => c.checked = false);

            // Clear all die/text inputs that are not SPS standard fields
            ['NippleDieInitial','NippleDieFinal','TubeDieInitial','TubeDieFinal',
             'MiddleDieInitial','MiddleDieFinal','CoverDieInitial','CoverDieFinal',
             'SpacerDieInitial','SpacerDieFinal','ToleranceInitial','ToleranceFinal'].forEach(name => {
                document.querySelectorAll(`input[name="${name}"]`).forEach(el => el.value = '');
            });

            // Clear dynamic lot rows
            ['inner','middle','outer','yarn'].forEach(layer => {
                const c = document.getElementById(layer + '-lot-list');
                if (c) c.innerHTML = '';
                if (materialState && materialState[layer]) materialState[layer] = [];
            });

            // Clear measurement data but KEEP the tabs (don't reset pReadings)
            // Only clear the parameter values inside each reading
            pReadings.forEach(reading => {
                reading.data = {}; // Clear data, but keep the tab structure
            });
            
            // Clear all parameter input fields
            document.querySelectorAll('#parameterCardsContainer input[id^="input_"]').forEach(inp => {
                inp.value = '';
            });
            
            // DO NOT call renderTabs() here - let it be handled by:
            // 1. restoreDraft() if draft exists (will restore pReadings + renderTabs)
            // 2. User action (addReadingPoint, removeReadingPoint, switchReadingTab)
            // This prevents visibility flicker during Planning switch
            
            // Reload current reading's empty data to refresh the form
            if (currentReadingIndex >= 0 && currentReadingIndex < pReadings.length) {
                loadCurrentDataFromMemory();
            }

            // Clear validation highlights
            document.querySelectorAll('#mainFormContainer .valid-success, #mainFormContainer .valid-error')
                .forEach(el => el.classList.remove('valid-success','valid-error'));
        }

        function applySpsToForm(sps) {
            console.log("Applying SPS Data:", sps);

            // Clear all previous operator-entered data first
            clearActualInputs();

            // UNLOCK FORM (SHOW CONTENT)
            const overlay = document.getElementById('formLockOverlay');
            const wrapper = document.getElementById('formContentBlurWrapper');
            const container = document.getElementById('mainFormContainer');

            if (overlay) overlay.remove(); // REMOVE COMPLETELY
            if (container) {
                container.style.minHeight = '0';
                container.style.pointerEvents = 'auto';
            }
            
            if (wrapper) {
                wrapper.style.display = 'block';
                wrapper.style.pointerEvents = 'auto';
                wrapper.style.opacity = '1';
                wrapper.style.visibility = 'visible';
                wrapper.classList.remove('d-none');
                wrapper.classList.add('animate__animated', 'animate__fadeInUp');
            }

            // Set numeric SPS ID only when the source actually provides one.
            const resolvedSpsId = sps.id || sps.Id || sps.spsId || '';
            document.getElementById('SpsId').value = /^\d+$/.test(String(resolvedSpsId).trim()) ? String(resolvedSpsId).trim() : '';
            const fallbackItemCode = document.getElementById('ItemCode').value;
            const itemCode = sps.itemList || sps.ItemList || sps.itemCode || sps.ItemCode || sps.productCode || sps.ProductCode || fallbackItemCode || '';
            document.getElementById('ItemCode').value = itemCode;
            document.getElementById('manualItemSearch').value = itemCode;
            document.getElementById('DocNo').value = sps.documentNumber || sps.DocumentNumber || '---';
            document.getElementById('RevNo').value = sps.revisionNumber || sps.RevisionNumber || '0';
            document.getElementById('HoseType').value = sps.hoseType || sps.HoseType || '';
            document.getElementById('CustomerName').value = sps.customerName || sps.CustomerName || '';
            
            // Keep resolved ItemCode; do not overwrite with empty value from partial SPS payload.
            const itemCodeEl = document.getElementById('ItemCode');
            if (itemCodeEl && !itemCodeEl.value) itemCodeEl.value = itemCode;

            let spsIdEl = document.getElementById('SpsId');
            if (spsIdEl) {
                const spsId = sps.id || sps.Id || sps.spsId || '';
                spsIdEl.value = /^\d+$/.test(String(spsId).trim()) ? String(spsId).trim() : '';
            }

            // Explicitly set material names to form inputs to ensure they save to DB
            const innerMatEl = document.getElementById('InnerMaterial');
            if (innerMatEl) innerMatEl.value = sps.innerMaterial || sps.InnerMaterial || sps.innerTube || sps.InnerTube || '';
            
            const outerMatEl = document.getElementById('OuterMaterial');
            if (outerMatEl) outerMatEl.value = sps.outerMaterial || sps.OuterMaterial || sps.material || sps.Material || '';
            
            const middleStd = sps.middleMaterial || sps.MiddleMaterial || sps.middleTube || sps.MiddleTube || '';
            const midEl = document.getElementById('MiddleMaterial');
            if (midEl) midEl.value = middleStd;

            // Set Yarn/Benang field
            const yarnStd = sps.yarnType || sps.YarnType || sps.yarn || sps.Yarn || '';
            const yarnEl = document.getElementById('Yarn');
            if (yarnEl) yarnEl.value = yarnStd;

            // Show/hide Middle material card based on LayerType (CHS 3 Layer)
            const layerType3L = (sps.layerType || sps.LayerType || '').toLowerCase();
            const machineName3L = (window.SESSION_MACHINE_NAME || '').toLowerCase();
            const is3Layer = layerType3L.includes('3') || layerType3L.includes('triple') || layerType3L.includes('three')
                          || machineName3L.includes('3l') || machineName3L.includes('chs3') || machineName3L.includes('3 layer') || machineName3L.includes('3layer')
                          || middleStd !== '';   // auto-detect: if SPS has a middle material, it's 3 layer
            const middleCard = document.getElementById('middleMaterialCard');
            if (middleCard) {
                middleCard.style.display = is3Layer ? '' : 'none';
            }

            // formatVal: server now returns Min | Asli | Max ranges directly
            const formatVal = (val, min, max) => {
                const fmt = v => (v != null && v !== '' && v !== 0 && v !== '0') ? String(v).trim() : '--';
                const strVal = fmt(val);
                const strMin = fmt(min);
                const strMax = fmt(max);
                
                if (strVal === '--' && strMin === '--' && strMax === '--') return '---';
                
                if (strMin !== '--' || strMax !== '--') {
                    return `${strMin} | ${strVal} | ${strMax}`;
                }
                return strVal === '--' ? '---' : strVal;
            };

            const specMappings = {
                'HeadTempInner':      sps.HeadTempInner || sps.headTempInner || formatVal(sps.HeadTemp1_Asli || sps.headTemp1_Asli || sps.HeadTemp1 || sps.headTemp1, sps.HeadTemp1_Min || sps.headTemp1_Min, sps.HeadTemp1_Max || sps.headTemp1_Max),
                'Cylinder1TempInner': sps.Cylinder1TempInner || sps.cylinder1TempInner || formatVal(sps.Cylinder1_1_Asli || sps.cylinder1_1_Asli || sps.Cylinder1_1 || sps.cylinder1_1, sps.Cylinder1_1_Min || sps.cylinder1_1_Min, sps.Cylinder1_1_Max || sps.cylinder1_1_Max),
                'Cylinder2TempInner': sps.Cylinder2TempInner || sps.cylinder2TempInner || formatVal(sps.Cylinder2_1_Asli || sps.cylinder2_1_Asli || sps.Cylinder2_1 || sps.cylinder2_1, sps.Cylinder2_1_Min || sps.cylinder2_1_Min, sps.Cylinder2_1_Max || sps.cylinder2_1_Max),
                'Cylinder3TempInner': sps.Cylinder3TempInner || sps.cylinder3TempInner || formatVal(sps.Cylinder3_1_Asli || sps.cylinder3_1_Asli || sps.Cylinder3_1 || sps.cylinder3_1, sps.Cylinder3_1_Min || sps.cylinder3_1_Min, sps.Cylinder3_1_Max || sps.cylinder3_1_Max),
                'ScrewTempInner':     sps.ScrewTempInner || sps.screwTempInner || formatVal(sps.ScrewTemp1_Asli || sps.screwTemp1_Asli || sps.ScrewTemp1 || sps.screwTemp1, sps.ScrewTemp1_Min || sps.screwTemp1_Min, sps.ScrewTemp1_Max || sps.screwTemp1_Max),
                'ScrewSpeedInner':    sps.ScrewSpeedInner || sps.screwSpeedInner || formatVal(sps.ScrewSpeed1_Asli || sps.screwSpeed1_Asli || sps.ScrewSpeed1 || sps.screwSpeed1, sps.ScrewSpeed1_Min || sps.screwSpeed1_Min, sps.ScrewSpeed1_Max || sps.screwSpeed1_Max),
                'FeedRollRatioInner': sps.FeedRollRatioInner || sps.feedRollRatioInner || formatVal(sps.FeedRollRatio1_Asli || sps.feedRollRatio1_Asli || sps.FeedRollRatio1 || sps.feedRollRatio1 || sps.Feed1_Asli || sps.feed1_Asli || sps.Feed1 || sps.feed1, sps.FeedRollRatio1_Min || sps.feedRollRatio1_Min || sps.Feed1_Min || sps.feed1_Min, sps.FeedRollRatio1_Max || sps.feedRollRatio1_Max || sps.Feed1_Max || sps.feed1_Max),
                'PressureInner':      sps.PressureInner || sps.pressureInner || formatVal(sps.Pressure1_Asli || sps.pressure1_Asli || sps.Pressure1 || sps.pressure1, sps.Pressure1_Min || sps.pressure1_Min, sps.Pressure1_Max || sps.pressure1_Max),

                'HeadTempOuter':      sps.HeadTempOuter || sps.headTempOuter || formatVal(sps.HeadTemp2_Asli || sps.headTemp2_Asli || sps.HeadTemp2 || sps.headTemp2, sps.HeadTemp2_Min || sps.headTemp2_Min, sps.HeadTemp2_Max || sps.headTemp2_Max),
                'Cylinder1TempOuter': sps.Cylinder1TempOuter || sps.cylinder1TempOuter || formatVal(sps.Cylinder1_2_Asli || sps.cylinder1_2_Asli || sps.Cylinder1_2 || sps.cylinder1_2, sps.Cylinder1_2_Min || sps.cylinder1_2_Min, sps.Cylinder1_2_Max || sps.cylinder1_2_Max),
