@model VelastoProductionSystem.Models.ProductionReport
@inject VelastoProductionSystem.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "EXTRUDER PRODUCTION REPORT";
    var shift1Start = DbContext.ShiftMasters.FirstOrDefault(s => s.ShiftName.Contains("1"))?.StartTime ?? "19:30";
    var shift2Start = DbContext.ShiftMasters.FirstOrDefault(s => s.ShiftName.Contains("2"))?.StartTime ?? "07:30";
}

<div class="production-blueprint no-print-bg pb-5">
    <div class="container-fluid p-1 p-md-2">
        
        <!-- HEADER HUD (NO BACKGROUND) -->
        <div class="mb-5 py-2">
            <div class="text-center">
                <h1 class="m-0 fw-black text-white letter-spacing-2" style="font-size: 1.6rem;">EXTRUDER PRODUCTION REPORT</h1>
                <div class="text-primary-glow fw-bold tracking-widest" style="font-size: 0.95rem;">(PARAMETER SETTING)</div>
            </div>
        </div>

        <form asp-action="Create" id="mainReportForm">
            <input type="hidden" id="SpsId" name="SpsId" value="" />
            <input type="hidden" id="MachineName" name="MachineName" value="" />
            
            <!-- HIDDEN FIELDS FOR PRODUCTION TIMER -->
            <input type="hidden" id="ProductionStartTime" name="ProductionStartTime" />
            <input type="hidden" id="ProductionEndTime" name="ProductionEndTime" />
            <!-- SECTION: PRODUCTION COMMAND CONSOLE (TOP HEADER) -->
            <div class="mb-4 no-print" style="position: relative; z-index: 1050; overflow: visible;">
                <style>
                    .pcc-wrapper {
                        background: linear-gradient(135deg, rgba(2,8,23,0.98) 0%, rgba(8,20,48,0.98) 100%);
                        border: 1px solid #38bdf8;
                        border-radius: 16px;
                        box-shadow: 0 0 20px rgba(56,189,248,0.25), 0 25px 50px rgba(0,0,0,0.6), inset 0 0 15px rgba(56,189,248,0.1);
                        overflow: visible;
                        position: relative;
                    }
                    .pcc-wrapper::before {
                        content: '';
                        position: absolute;
                        top: 0; left: 0; right: 0;
                        height: 2px;
                        background: linear-gradient(90deg, transparent 0%, rgba(14,165,233,0.8) 30%, rgba(56,189,248,1) 50%, rgba(14,165,233,0.8) 70%, transparent 100%);
                        border-radius: 16px 16px 0 0;
                    }
                    .pcc-topbar {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        padding: 14px 20px 12px;
                        border-bottom: 1px solid rgba(14,165,233,0.12);
                        background: linear-gradient(90deg, rgba(14,165,233,0.08) 0%, transparent 60%);
                    }
                    .pcc-brand {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                    }
                    .pcc-brand-icon {
                        width: 36px; height: 36px;
                        background: linear-gradient(135deg, rgba(14,165,233,0.2), rgba(56,189,248,0.1));
                        border: 1px solid rgba(14,165,233,0.4);
                        border-radius: 10px;
                        display: flex; align-items: center; justify-content: center;
                        color: #38bdf8;
                        font-size: 1rem;
                        box-shadow: 0 0 15px rgba(14,165,233,0.2);
                    }
                    .pcc-title {
                        font-size: 0.75rem;
                        font-weight: 900;
                        letter-spacing: 3px;
                        color: #e0f2fe;
                        font-family: monospace;
                        line-height: 1;
                    }
                    .pcc-subtitle {
                        font-size: 0.58rem;
                        color: rgba(14,165,233,0.6);
                        letter-spacing: 2px;
                        font-family: monospace;
                        margin-top: 2px;
                    }
                    .pcc-meta-badge {
                        display: flex;
                        gap: 10px;
                        align-items: center;
                    }
                    .pcc-badge-item {
                        display: flex;
                        align-items: center;
                        gap: 6px;
                        background: rgba(14,165,233,0.12);
                        border: 1px solid rgba(14,165,233,0.35);
                        border-radius: 8px;
                        padding: 5px 12px;
                        font-size: 0.65rem;
                        color: rgba(255,255,255,0.85);
                        font-family: monospace;
                        letter-spacing: 1px;
                    }
                    .pcc-badge-item i { color: #38bdf8; }
                    .pcc-badge-item input {
                        background: transparent;
                        border: none;
                        color: #ffffff;
                        font-family: monospace;
                        font-size: 0.65rem;
                        width: 60px;
                        outline: none;
                        letter-spacing: 1px;
                        font-weight: 700;
                    }
                    .pcc-search-grid {
                        padding: 16px 20px;
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 12px;
                        border-bottom: 1px solid rgba(14,165,233,0.08);
                    }
                    .pcc-search-box {
                        background: rgba(255,255,255,0.03);
                        border: 1px solid rgba(56,189,248,0.8);
                        border-radius: 12px;
                        display: flex;
                        flex-direction: column;
                        padding: 10px 14px;
                        gap: 4px;
                        transition: border-color 0.2s, box-shadow 0.2s;
                        cursor: pointer;
                        position: relative;
                    }
                    .pcc-search-box:focus-within {
                        border-color: rgba(14,165,233,0.6);
                        box-shadow: 0 0 0 3px rgba(14,165,233,0.08), 0 0 20px rgba(14,165,233,0.1);
                    }
                    .pcc-search-label {
                        font-size: 0.58rem;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: #38bdf8;
                        font-family: monospace;
                        display: flex;
                        align-items: center;
                        gap: 6px;
                    }
                    .pcc-search-input {
                        background: transparent;
                        border: none;
                        outline: none;
                        color: #f0f9ff;
                        font-family: monospace;
                        font-size: 0.9rem;
                        font-weight: 700;
                        width: 100%;
                    }
                    .pcc-search-input::placeholder { color: rgba(148,163,184,0.4); font-weight: 400; }
                    .pcc-search-action {
                        position: absolute;
                        right: 12px; top: 50%;
                        transform: translateY(-50%);
                        background: rgba(14,165,233,0.12);
                        border: 1px solid rgba(14,165,233,0.25);
                        border-radius: 8px;
                        color: #38bdf8;
                        width: 34px; height: 34px;
                        display: flex; align-items: center; justify-content: center;
                        cursor: pointer;
                        transition: all 0.2s;
                    }
                    .pcc-search-action:hover {
                        background: rgba(14,165,233,0.25);
                        box-shadow: 0 0 12px rgba(14,165,233,0.3);
                    }
                    .pcc-meta-grid {
                        padding: 14px 20px;
                        display: grid;
                        grid-template-columns: 1fr 1fr 1fr 1fr;
                        gap: 10px;
                    }
                    .pcc-field {
                        background: rgba(255,255,255,0.02);
                        border: 1px solid rgba(56,189,248,0.6);
                        border-radius: 10px;
                        padding: 8px 12px;
                        display: flex;
                        flex-direction: column;
                        gap: 3px;
                        transition: border-color 0.2s;
                    }
                    .pcc-field:focus-within {
                        border-color: rgba(14,165,233,0.3);
                    }
                    .pcc-field-label {
                        font-size: 0.55rem;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: #38bdf8;
                        font-family: monospace;
                        display: flex; align-items: center; gap: 5px;
                    }
                    .pcc-field-input {
                        background: transparent;
                        border: none;
                        outline: none;
                        color: #e2e8f0;
                        font-family: monospace;
                        font-size: 0.82rem;
                        font-weight: 700;
                        width: 100%;
                    }
                    .pcc-field-input::placeholder { color: rgba(148,163,184,0.35); font-weight: 400; }
                    .pcc-field-input option { background: #0f172a; }
                    @@media (max-width: 1024px) {
                        .pcc-search-grid { grid-template-columns: 1fr; }
                        .pcc-meta-grid { grid-template-columns: 1fr 1fr; }
                        .pcc-meta-badge { flex-wrap: wrap; gap: 6px; }
                        .pcc-badge-item input { width: 110px; }
                    }
                    @@media (max-width: 480px) {
                        .pcc-meta-badge { display: none; }
                    }
                </style>

                <div class="pcc-wrapper">
                    <!-- TOP BAR -->
                    <div class="pcc-topbar">
                        <div class="pcc-brand">
                            <div class="pcc-brand-icon">
                                <i class="bi bi-terminal-fill"></i>
                            </div>
                            <div>
                                <div class="pcc-title">PRODUCTION</div>
                                <div class="pcc-subtitle">VELASTO INDUSTRIAL</div>
                            </div>
                        </div>
                        <div class="pcc-meta-badge">
                            <div class="pcc-badge-item">
                                <i class="bi bi-file-text-fill"></i>
                                DOC:&nbsp;<input asp-for="DocumentNumber" id="DocNo" placeholder="AUTO" style="width:140px;" />
                            </div>
                            <div class="pcc-badge-item">
                                <i class="bi bi-activity"></i>
                                REV:&nbsp;<input asp-for="RevisionNumber" id="RevNo" placeholder="0" style="width:30px;" />
                            </div>
                        </div>
                    </div>

                    <!-- SEARCH ROW -->
                    <div class="pcc-search-grid">
                        <!-- Planning Master -->
                        <div class="pcc-search-box" onclick="document.getElementById('planningSearch').focus(); openPlanningDropdown();">
                            <div class="pcc-search-label">
                                <i class="bi bi-list-check"></i>
                                PLANNING MASTER
                                    <span style="font-size:9px; font-weight:900; color:#10b981; background:rgba(16,185,129,0.1); padding:1px 8px; border-radius:20px; border:1px solid rgba(16,185,129,0.3);">
                                        <i class="bi bi-shield-fill me-1"></i>ALL MACHINES
                                    </span>
                            </div>
                            <input id="planningSearch" type="text" class="pcc-search-input"
                                   placeholder="PILIH PLANNING MASTER..."
                                   oninput="filterPlanningResults(this.value)"
                                   onfocus="openPlanningDropdown()"
                                   onclick="openPlanningDropdown()"
                                   autocomplete="off" readonly />
                            
                            <!-- Tactical Results Container -->
                            <div id="planningResults" class="d-none custom-tactical-scroll"
                                 style="position: absolute; top: calc(100% + 5px); left: 0; right: 0; background: #020617; border: 1px solid rgba(14,165,233,0.4); z-index: 9999; max-height: 450px; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.9), 0 0 30px rgba(14,165,233,0.1); border-radius: 12px;">
                                <!-- Items will be injected here -->
                            </div>
                        </div>

                        <!-- Manual Protocol -->
                        <div class="pcc-search-box">
                            <div class="pcc-search-label">
                                <i class="bi bi-keyboard"></i>
                                MANUAL PROTOCOL
                            </div>
                            <input id="manualItemSearch" type="text" class="pcc-search-input"
                                   placeholder="SEARCH SPS MASTERLIST..."
                                   onchange="if(this.value) fetchSpsByItem(this.value)"
                                   onkeyup="if(event.key==='Enter' && this.value){ fetchSpsByItem(this.value); this.blur(); }"
                                   autocomplete="off" />
                            <button type="button"
                                    onclick="let v=document.getElementById('manualItemSearch').value; if(v) fetchSpsByItem(v);"
                                    class="pcc-search-action">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>

                    <!-- META FIELDS ROW -->
                    <div class="pcc-meta-grid">
                        <!-- System Date -->
                        <div class="pcc-field">
                            <div class="pcc-field-label">
                                <i class="bi bi-calendar-check-fill"></i> SYSTEM DATE
                            </div>
                            <input type="date" asp-for="ProductionDate" id="ProductionDate"
                                   class="pcc-field-input"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   required onchange="refreshPlanningItems()" />
                        </div>

                        <!-- Shift Monitoring -->
                        <div class="pcc-field">
                            <div class="pcc-field-label">
                                <i class="bi bi-clock-history"></i> SHIFT MONITORING
                            </div>
                            <select asp-for="Shift" id="Shift" class="pcc-field-input" onchange="refreshPlanningItems()" style="pointer-events: none; -webkit-appearance: none; -moz-appearance: none; appearance: none;" tabindex="-1">
                                <option value="Shift 1" class="bg-dark">SHIFT 1 (@shift1Start - @shift2Start)</option>
                                <option value="Shift 2" class="bg-dark">SHIFT 2 (@shift2Start - @shift1Start)</option>
                            </select>
                        </div>

                        <!-- Customer Entity -->
                        <div class="pcc-field">
                            <div class="pcc-field-label">
                                <i class="bi bi-building-fill"></i> CUSTOMER ENTITY
                            </div>
                            <input asp-for="CustomerName" id="CustomerName"
                                   class="pcc-field-input" placeholder="PT. ADM" />
                        </div>

                        <!-- Hose Specification Type -->
                        <div class="pcc-field">
                            <div class="pcc-field-label">
                                <i class="bi bi-cpu-fill"></i> HOSE SPEC TYPE
                            </div>
                            <input asp-for="HoseType" id="HoseType"
                                   class="pcc-field-input" placeholder="Spec Name..." />
                        </div>
                    </div>
                </div>
            </div>

            <!-- MAIN FORM CONTENT: LOCKED & HIDDEN UNTIL PLANNING SELECTED -->
            <div id="mainFormContainer" class="form-locked-state" style="position: relative; min-height: 450px; transition: all 0.5s ease;">
                <!-- LOCK OVERLAY (Indicator) -->
                <div id="formLockOverlay" class="d-flex flex-column align-items-center justify-content-center" 
                     style="position: absolute; top:0; left:0; right:0; bottom:20px; z-index: 1000; background: rgba(2, 6, 23, 0.65); border-radius: 12px; backdrop-filter: none !important; -webkit-backdrop-filter: none !important;">
                    <div class="text-center p-5 rounded-4 border border-info border-opacity-30 shadow-hud-blue" style="background: rgba(15, 23, 42, 0.95);">
                        <div class="mb-4">
                            <i class="bi bi-shield-lock-fill text-info" style="font-size: 5rem; filter: drop-shadow(0 0 20px rgba(14, 165, 233, 0.6));"></i>
                        </div>
                        <h2 class="text-white fw-900 tracking-widest mb-2" style="font-size: 1.5rem;">FORM LOCKED</h2>
                        <p class="text-info opacity-70 super-small mb-0 tracking-widest uppercase">PLEASE SELECT PLANNING MASTER<br/>OR MANUAL PROTOCOL TO REVEAL DATA ENTRY</p>
                    </div>
                </div>

                <!-- CONTENT WRAPPER (Hidden by default) -->
                <div id="formContentBlurWrapper" style="display: none;">
                   <div class="py-4"> <!-- Spacer when revealed -->
            <!-- ROW 2: MATERIAL & MESH CHECKING -->
            <style>
                .hud-pill-group {
                    display: inline-flex;
                    background: rgba(15, 23, 42, 0.6);
                    padding: 4px;
                    border-radius: 8px;
                    border: 1px solid rgba(14, 165, 233, 0.2);
                    width: 100%;
                    gap: 4px;
                }
                .hud-pill-item {
                    flex: 1;
                    padding: 8px 4px;
                    font-size: 0.75rem;
                    font-weight: 900;
                    color: rgba(255, 255, 255, 0.3);
                    border-radius: 6px;
                    cursor: pointer;
                    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
                    text-transform: uppercase;
                    text-align: center;
                    border: 1px solid transparent;
                }
                .hud-pill-item input { display: none; }
                .hud-pill-item:has(input:checked) {
                    background: #10b981;
                    color: white;
                    box-shadow: 0 0 15px rgba(16, 185, 129, 0.5);
                    border-color: rgba(255,255,255,0.2);
                }
                .hud-pill-item.red:has(input:checked) { 
                    background: #ef4444; 
                    box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
                }
                .hud-pill-item.orange:has(input:checked) { 
                    background: #f59e0b; 
                    box-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
                }
                .hud-pill-group.sm { border-radius: 6px; padding: 4px; }
                .hud-pill-group.sm .hud-pill-item { padding: 8px 2px; font-size: 0.7rem; border-radius: 4px; }
                
                .compact-hud td { padding: 4px 1px !important; } /* REDUCED PADDING TO PREVENT INPUT SQUEEZING */
                .compact-hud th { padding: 6px 1px !important; }
                .instrument-style { font-family: 'JetBrains Mono', 'Roboto Mono', monospace; }

                /* INTEGRATED DASHBOARD PILLS */
                .hud-pill-integrated { 
                    background: rgba(30, 41, 59, 0.4); 
                    border: 1px solid rgba(14, 165, 233, 0.2); 
                    border-radius: 6px; 
                    padding: 8px 12px; 
                    display: flex; 
                    flex-direction: column; 
                    transition: all 0.3s;
                }
                .hud-pill-integrated:focus-within { 
                    border-color: #0ea5e9; 
                    background: rgba(14, 165, 233, 0.1); 
                    box-shadow: 0 0 15px rgba(14, 165, 233, 0.2); 
                }
                .hud-pill-integrated label { 
                    font-size: 0.6rem; 
                    font-weight: 800; 
                    color: #38bdf8; 
                    letter-spacing: 1px; 
                    margin-bottom: 4px; 
                    text-transform: uppercase;
                }
                .hud-pill-integrated .hud-input { 
                    font-size: 0.85rem; 
                    background: transparent; 
                    border: none; 
                    color: white; 
                    padding: 0; 
                    width: 100%;
                    outline: none;
                }
                .group-lane { background: rgba(14, 165, 233, 0.03); }
                .font-black { font-weight: 900 !important; font-size: 0.6rem !important; }

                /* CUSTOM CHECKBOX STYLE - LARGE & FUTURISTIC */
                .hud-check-box { position: relative; width: 32px; height: 32px; margin: 0 auto; cursor: pointer; }
                .hud-check-box input { 
                    position: absolute; 
                    opacity: 0; 
                    width: 100%; 
                    height: 100%; 
                    cursor: pointer; 
                    z-index: 2; 
                    margin: 0;
                }
                .hud-check-box span {
                    position: absolute; top: 0; left: 0; height: 32px; width: 32px;
                    background-color: rgba(15, 23, 42, 0.6);
                    border: 2px solid rgba(14, 165, 233, 0.2);
                    border-radius: 8px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                    z-index: 1;
                }
                .hud-check-box:hover input ~ span { border-color: #0ea5e9; background: rgba(14, 165, 233, 0.1); }
                .hud-check-box input:checked ~ span { 
                    background-color: #0ea5e9; 
                    border-color: white; 
                    box-shadow: 0 0 20px rgba(14, 165, 233, 0.6); 
                }
                .hud-check-box span:after {
                    content: ""; position: absolute; display: none;
                    left: 11px; top: 5px; width: 8px; height: 16px;
                    border: solid white; border-width: 0 4px 4px 0;
                    transform: rotate(45deg);
                }
                .hud-check-box input:checked ~ span:after { display: block; }
                
                .hud-card-header {
                    background: linear-gradient(90deg, rgba(14, 165, 233, 0.15) 0%, transparent 100%);
                    border-bottom: 1px solid rgba(14, 165, 233, 0.3);
                    padding: 10px 20px;
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    border-top-left-radius: 10px;
                    border-top-right-radius: 10px;
                }
                .hud-card-title {
                    font-size: 0.85rem;
                    font-weight: 900;
                    letter-spacing: 2px;
                    color: #0ea5e9;
                    text-transform: uppercase;
                }
                .hud-card-icon { color: #0ea5e9; font-size: 1.1rem; }
                
                .table-hud-unified { width: 100%; border-collapse: collapse; }
                .table-hud-unified th { 
                    padding: 12px; 
                    font-size: 0.65rem; 
                    font-weight: 800; 
                    color: rgba(255, 255, 255, 0.5); 
                    text-transform: uppercase; 
                    letter-spacing: 1px;
                    border-bottom: 1px solid rgba(255,255,255,0.05);
                }
                .table-hud-unified td { padding: 12px; vertical-align: middle; border-bottom: 1px solid rgba(255,255,255,0.05); }
                .label-stack { display: flex; flex-direction: column; gap: 2px; }
                .label-main { font-size: 0.85rem; font-weight: 900; color: white; line-height: 1; }
                .label-sub { font-size: 0.6rem; font-weight: 700; color: #60a5fa; text-transform: uppercase; opacity: 0.8; }
                
                /* SCAN ZONE STYLING */
                .hud-th-scan { background: rgba(14, 165, 233, 0.05); color: #0ea5e9 !important; font-weight: 900 !important; }
                .hud-td-scan { background: rgba(0, 0, 0, 0.2); padding: 8px 12px !important; }
                .hud-scan-group {
                    display: flex;
                    align-items: center;
                    background: rgba(15, 23, 42, 0.6);
                    border: 1px solid rgba(14, 165, 233, 0.2);
                    border-radius: 6px;
                    padding: 2px 4px;
                    transition: all 0.3s;
                }
                .hud-scan-group:focus-within {
                    border-color: #0ea5e9;
                    box-shadow: 0 0 15px rgba(14, 165, 233, 0.2);
                    background: rgba(14, 165, 233, 0.05);
                }
                .hud-input-scan {
                    background: transparent;
                    border: none;
                    color: #0ea5e9;
                    font-weight: 900;
                    font-size: 0.85rem;
                    padding: 8px;
                    width: 100%;
                    outline: none;
                    letter-spacing: 1px;
                }
                .hud-scan-btn {
                    background: rgba(14, 165, 233, 0.1);
                    border: none;
                    color: #0ea5e9;
                    padding: 6px 10px;
                    border-radius: 4px;
                    cursor: pointer;
                    transition: all 0.2s;
                }
                .hud-scan-btn:hover { background: #0ea5e9; color: white; }
                .hud-input-underlined {
                    background: transparent;
                    border: none;
                    border-bottom: 2px solid rgba(255, 255, 255, 0.05);
                    color: white;
                    font-weight: 900;
                    width: 100%;
                    padding: 8px 0; /* REMOVED TO PREVENT CLIPPING */
                    text-align: center;
                    transition: all 0.3s;
                    font-size: 1.1rem; /* HIGHER LEGIBILITY */
                    min-height: 46px; /* MATCHES CELL HEIGHT */
                    font-family: 'JetBrains Mono', monospace;
                }
                .hud-input-underlined:focus {
                    outline: none;
                    border-bottom-color: #3b82f6;
                    background: rgba(59, 130, 246, 0.05);
                }
                .param-row-hud { 
                    transition: all 0.3s; 
                    background: rgba(255,255,255,0.03);
                    border: 1px solid rgba(255,255,255,0.05);
                }
                .param-row-hud:hover { 
                    background: rgba(56, 189, 248, 0.08); 
                    border-color: rgba(56, 189, 248, 0.2);
                    transform: translateY(-2px);
                }
                
                .text-info-glow {
                    color: #38bdf8;
                    text-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
                }

                .valid-success { 
                    background: rgba(16, 185, 129, 0.15) !important; 
                    border-bottom-color: #10b981 !important; 
                    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
                    color: #10b981 !important;
                }
                .valid-error { 
                    background: rgba(239, 68, 68, 0.15) !important; 
                    border-bottom-color: #ef4444 !important; 
                    box-shadow: 0 4px 15px rgba(239, 68, 68, 0.2);
                    color: #ef4444 !important;
                    animation: shake-hud 0.4s ease-in-out;
                }
                
                @@keyframes shake-hud { 0%,100% { transform:translateX(0); } 20%,60% { transform:translateX(-5px); } 40%,80% { transform:translateX(5px); } }
                
                .btn-detail-toggle { background: transparent; border: none; color: #38bdf8; transition: all 0.3s; }
                .btn-detail-toggle.active i { transform: rotate(180deg); color: #f59e0b; opacity: 1 !important; }

                .valid-success { border-bottom-color: #10b981 !important; color: #10b981 !important; text-shadow: 0 0 10px rgba(16, 185, 129, 0.4); }
                .valid-error { border-bottom-color: #ef4444 !important; color: #ef4444 !important; text-shadow: 0 0 10px rgba(239, 68, 68, 0.4); }
                
                .custom-scrollbar::-webkit-scrollbar { height: 4px; }
                .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(56, 189, 248, 0.2); border-radius: 10px; }
                
                @@keyframes blink-blue { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; color: #38bdf8; } }

                /* STANDARD SUGGESTION BOX */
                .std-suggestion-box {
                    display: none; position: absolute; top: 100%; left: 0; right: 0;
                    background: #0f172a; border: 1px solid rgba(14, 165, 233, 0.4);
                    border-radius: 4px; z-index: 1000; margin-top: 2px;
                    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
                }
                .std-suggestion-item {
                    padding: 8px 12px; font-size: 0.8rem; font-weight: 800; color: #38bdf8;
                    cursor: pointer; transition: 0.2s; border-bottom: 1px solid rgba(255,255,255,0.05);
                }
                .std-suggestion-item:hover { background: rgba(14, 165, 233, 0.15); color: #fff; }
                .std-suggestion-label { font-size: 0.55rem; color: rgba(255,255,255,0.4); margin-bottom: 2px; display: block; }
            </style>

            <div class="row g-4 mb-5">
                <!-- CARD 1: MATERIAL -->
                <div class="col-lg-7">
                    <div class="hud-card h-100 shadow-hud-blue border-white border-opacity-10 overflow-hidden">
                        <div class="hud-card-header">
                            <i class="bi bi-box-seam hud-card-icon"></i>
                            <span class="hud-card-title">MATERIAL & LOT TRACKING</span>
                        </div>
                        <div class="p-3 bg-black bg-opacity-20 d-flex flex-column gap-3">
                            <!-- INNER COMPOUND -->
                            <div class="hud-pill-integrated border border-info border-opacity-20 p-3 shadow-sm" style="background: rgba(15, 23, 42, 0.8);">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-white border-opacity-10">
                                    <div class="label-stack"><span class="label-sub text-info">INNER (MATERIAL)</span><span class="label-main">COMPOUND</span></div>
                                    <button type="button" onclick="addMaterialRow('inner')" class="btn btn-sm btn-outline-info border-0 rounded-circle p-1" style="width: 28px; height: 28px; background: rgba(14, 165, 233, 0.1);">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-4">
                                        <label class="super-small text-white-50 mb-1">STANDARD</label>
                                        <input asp-for="InnerMaterial" id="InnerMaterial" class="hud-input font-monospace text-white opacity-50 w-100" readonly />
                                    </div>
                                    <div class="col-8">
                                        <label class="super-small text-info mb-1">ACTUAL BATCH NAME</label>
                                        <div style="position: relative;">
                                            <input asp-for="InnerMaterialActual" id="InnerMaterialActual" 
                                                   class="hud-input font-monospace text-white w-100" 
                                                   placeholder="Input Actual..." 
                                                   onfocus="showStdSuggestion('InnerMaterial', 'InnerMaterialActual', 'inner-std-dropdown')"
                                                   onblur="hideStdSuggestion('inner-std-dropdown')"
                                                   autocomplete="off" />
                                            <div id="inner-std-dropdown" class="std-suggestion-box"></div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Dynamic List for Inner -->
                                <div id="inner-lot-list" class="d-flex flex-column gap-2 mt-2">
                                    <!-- Rows will be added here -->
                                </div>
                            </div>

                            <!-- MIDDLE COMPOUND (CHS 3 LAYER ONLY - hidden by default) -->
                            <div id="middleMaterialCard" class="hud-pill-integrated border p-3 shadow-sm" 
                                 style="display:none; background: rgba(15, 23, 42, 0.8); border-color: rgba(167,139,250,0.35) !important;">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-white border-opacity-10">
                                    <div class="label-stack">
                                        <span class="label-sub" style="color:#a78bfa;">MIDDLE (MATERIAL)</span>
                                        <span class="label-main" style="color:#c4b5fd;">COMPOUND 3L</span>
                                    </div>
                                    <button type="button" onclick="addMaterialRow('middle')" class="btn btn-sm border-0 rounded-circle p-1" style="width: 28px; height: 28px; background: rgba(167,139,250,0.15); color:#a78bfa;">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-4">
                                        <label class="super-small text-white-50 mb-1">STANDARD</label>
                                        <input id="MiddleMaterial" name="MiddleMaterial" class="hud-input font-monospace w-100" style="color:rgba(196,181,253,0.6);" readonly />
                                    </div>
                                    <div class="col-8">
                                        <label class="super-small mb-1" style="color:#a78bfa;">ACTUAL BATCH NAME</label>
                                        <div style="position: relative;">
                                            <input id="MiddleMaterialActual" name="MiddleMaterialActual"
                                                   class="hud-input font-monospace text-white w-100" 
                                                   placeholder="Input Actual..." 
                                                   onfocus="showStdSuggestion('MiddleMaterial', 'MiddleMaterialActual', 'middle-std-dropdown')"
                                                   onblur="hideStdSuggestion('middle-std-dropdown')"
                                                   autocomplete="off" />
                                            <div id="middle-std-dropdown" class="std-suggestion-box"></div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Dynamic List for Middle -->
                                <div id="middle-lot-list" class="d-flex flex-column gap-2 mt-2">
                                    <!-- Rows will be added here -->
                                </div>
                            </div>

                            <!-- OUTER COMPOUND -->
                            <div class="hud-pill-integrated border border-warning border-opacity-20 p-3 shadow-sm" style="background: rgba(15, 23, 42, 0.8);">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-white border-opacity-10">
                                    <div class="label-stack"><span class="label-sub text-warning">OUTER (MATERIAL)</span><span class="label-main">COMPOUND</span></div>
                                    <button type="button" onclick="addMaterialRow('outer')" class="btn btn-sm btn-outline-warning border-0 rounded-circle p-1" style="width: 28px; height: 28px; background: rgba(245, 158, 11, 0.1);">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-4">
                                        <label class="super-small text-white-50 mb-1">STANDARD</label>
                                        <input asp-for="OuterMaterial" id="OuterMaterial" class="hud-input font-monospace text-white opacity-50 w-100" readonly />
                                    </div>
                                    <div class="col-8">
                                        <label class="super-small text-warning mb-1">ACTUAL BATCH NAME</label>
                                        <div style="position: relative;">
                                            <input asp-for="OuterMaterialActual" id="OuterMaterialActual" 
                                                   class="hud-input font-monospace text-white w-100" 
                                                   placeholder="Input Actual..." 
                                                   onfocus="showStdSuggestion('OuterMaterial', 'OuterMaterialActual', 'outer-std-dropdown')"
                                                   onblur="hideStdSuggestion('outer-std-dropdown')"
                                                   autocomplete="off" />
                                            <div id="outer-std-dropdown" class="std-suggestion-box"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dynamic List for Outer -->
                                <div id="outer-lot-list" class="d-flex flex-column gap-2 mt-2">
                                    <!-- Rows will be added here -->
                                </div>
                            </div>

                            <!-- YARN SUPPORT -->
                            <div id="yarnMaterialCard" class="hud-pill-integrated border border-success border-opacity-20 p-3 shadow-sm" style="background: rgba(15, 23, 42, 0.8);">
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-white border-opacity-10">
                                    <div class="label-stack"><span class="label-sub text-success">YARN (SUPPORT)</span><span class="label-main">POLYESTER</span></div>
                                    <button type="button" onclick="addMaterialRow('yarn')" class="btn btn-sm btn-outline-success border-0 rounded-circle p-1" style="width: 28px; height: 28px; background: rgba(16, 185, 129, 0.1);">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-4">
                                        <label class="super-small text-white-50 mb-1">STANDARD</label>
                                        <input asp-for="Yarn" id="Yarn" class="hud-input font-monospace text-white opacity-50 w-100" readonly />
                                    </div>
                                    <div class="col-8">
                                        <label class="super-small text-success mb-1">ACTUAL BATCH NAME</label>
                                        <div style="position: relative;">
                                            <input asp-for="YarnActual" id="YarnActual" 
                                                   class="hud-input font-monospace text-white w-100" 
                                                   placeholder="Input Actual..." 
                                                   onfocus="showStdSuggestion('Yarn', 'YarnActual', 'yarn-std-dropdown')"
                                                   onblur="hideStdSuggestion('yarn-std-dropdown')"
                                                   autocomplete="off" />
                                            <div id="yarn-std-dropdown" class="std-suggestion-box"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dynamic List for Yarn -->
                                <div id="yarn-lot-list" class="d-flex flex-column gap-2 mt-2">
                                    <!-- Rows will be added here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: MESH & EMBOSS -->
                <div class="col-lg-5">
                    <div class="hud-card h-100 shadow-hud-blue border-white border-opacity-10 overflow-hidden">
                        <div class="hud-card-header">
                            <i class="bi bi-patch-check hud-card-icon"></i>
                            <span class="hud-card-title">MESH & EMBOSS QUALITY</span>
                        </div>
                        <div class="p-3 bg-slate-800 bg-opacity-40 flex-grow-1" style="background: rgba(30, 41, 59, 0.4);">
                            <!-- CATEGORY: TIPE MESH (BEFORE) -->
                            <div class="mb-4 pb-3">
                                <div class="label-stack mb-2">
                                    <div class="d-flex justify-content-between align-items-center w-100">
                                         <div>
                                             <span class="label-sub text-info-glow fw-bold"><i class="bi bi-layers me-1"></i>TIPE MESH</span>
                                             <span class="label-main small text-white fw-900">INNER & OUTER SELECTION (BEFORE)</span>
                                         </div>
                                     </div>
                                 </div>
                                <div class="row g-2">
                                    <!-- INNER GROUP -->
                                    <div class="col-6">
                                        <div class="p-2 rounded-3 bg-slate-900 bg-opacity-60 border border-white border-opacity-20 text-center">
                                            <span class="label-main small text-white fw-900 opacity-75 d-block mb-3 border-bottom border-white border-opacity-10 pb-1">INNER LAYER</span>
                                             <div class="d-flex justify-content-center gap-4 py-1">
                                                 <div class="d-flex flex-column align-items-center gap-1">
                                                     <div class="hud-check-box sm"><input type="checkbox" asp-for="MeshInner10Before"><span></span></div>
                                                     <span id="label_MeshInner1" class="super-small text-white fw-bold">--</span>
                                                 </div>
                                                 <div class="d-flex flex-column align-items-center gap-1">
                                                     <div class="hud-check-box sm"><input type="checkbox" asp-for="MeshInner40Before"><span></span></div>
                                                     <span id="label_MeshInner2" class="super-small text-white fw-bold">--</span>
                                                 </div>
                                             </div>
                                        </div>
                                    </div>
                                    <!-- OUTER GROUP -->
                                    <div class="col-6">
                                        <div class="p-2 rounded-3 bg-slate-900 bg-opacity-60 border border-white border-opacity-20 text-center">
                                            <span class="label-main small text-white fw-900 opacity-75 d-block mb-3 border-bottom border-white border-opacity-10 pb-1">OUTER LAYER</span>
                                             <div class="d-flex justify-content-center gap-4 py-1">
                                                 <div class="d-flex flex-column align-items-center gap-1">
                                                     <div class="hud-check-box sm"><input type="checkbox" asp-for="MeshOuter10Before"><span></span></div>
                                                     <span id="label_MeshOuter1" class="super-small text-white fw-bold">--</span>
                                                 </div>
                                                 <div class="d-flex flex-column align-items-center gap-1">
                                                     <div class="hud-check-box sm"><input type="checkbox" asp-for="MeshOuter40Before"><span></span></div>
                                                     <span id="label_MeshOuter2" class="super-small text-white fw-bold">--</span>
                                                 </div>
                                             </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- CATEGORY: MESH CHECK (AFTER) -->
                            <div class="mb-4 border-bottom border-white border-opacity-20 pb-4">
                                <div class="label-stack mb-2"><span class="label-sub text-info-glow fw-bold"><i class="bi bi-shield-check me-1"></i>MESH CHECK</span><span class="label-main small text-white fw-900">QUALITY VERIFICATION (AFTER)</span></div>
                                <div class="d-flex flex-column gap-3 mt-2">
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-slate-900 bg-opacity-50 border border-white border-opacity-20">
                                        <span class="label-main text-white fw-black" style="font-size: 0.8rem; min-width:80px">INNER</span>
                                        <div class="hud-pill-group"><label class="hud-pill-item">OK<input type="radio" asp-for="MeshInnerCheck" value="OK"></label><label class="hud-pill-item red">BOLONG<input type="radio" asp-for="MeshInnerCheck" value="BOLONG"></label><label class="hud-pill-item orange">ASING<input type="radio" asp-for="MeshInnerCheck" value="ASING"></label></div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-slate-900 bg-opacity-50 border border-white border-opacity-20">
                                        <span class="label-main text-white fw-black" style="font-size: 0.8rem; min-width:80px">OUTER</span>
                                        <div class="hud-pill-group"><label class="hud-pill-item">OK<input type="radio" asp-for="MeshOuterCheck" value="OK"></label><label class="hud-pill-item red">BOLONG<input type="radio" asp-for="MeshOuterCheck" value="BOLONG"></label><label class="hud-pill-item orange">ASING<input type="radio" asp-for="MeshOuterCheck" value="ASING"></label></div>
                                    </div>
                                </div>
                            </div>

                            <!-- CATEGORY: EMBOSSING & QC -->
                            <div class="p-3 bg-slate-900 bg-opacity-70 border border-white border-opacity-20 rounded-4">
                                <div class="label-stack mb-3"><span class="label-sub text-info-glow fw-bold">FINAL SECURITY</span><span class="label-main small text-white fw-900">MARKING & QC ANALYTICS</span></div>
                                <div class="row g-2 mb-3">
                                    <div class="col-7">
                                        <div class="p-2 px-3 rounded-3 border border-white border-opacity-30 bg-black bg-opacity-40 shadow-sm h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="super-small text-info-glow fw-black mb-0"><i class="bi bi-fonts me-1"></i>MARK CONTENT DATA</label>
                                                <span id="std_Marking" class="super-small text-info-glow opacity-75 font-monospace">STD: --</span>
                                            </div>
                                            <input asp-for="EmbossMarkContent" class="hud-input w-100 border-0 bg-transparent text-white fw-bold font-monospace mt-1" style="font-size: 1rem;" placeholder="[ ENTER SEQUENCE ]" />
                                        </div>
                                    </div>
                                    <div class="col-5">
                                        <div class="p-2 px-3 rounded-3 border border-white border-opacity-30 bg-black bg-opacity-40 shadow-sm h-100">
                                            <label class="super-small text-info-glow fw-black mb-1"><i class="bi bi-calendar-event me-1"></i>VERIFICATION DATE</label>
                                            <input type="date" asp-for="EmbossMarkDate" class="hud-input w-100 border-0 bg-transparent text-white fw-bold font-monospace mt-1" style="font-size: 1rem; color-scheme: dark;" />
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex flex-column gap-3">
                                    @{
                                        var qcMetricsLight = new[] { 
                                            new { Label = "CONDITION", Sub = "Q.01", Field = "QcCond", Opt1 = "BERSIH", Opt2 = "KOTOR" },
                                            new { Label = "SURFACE", Sub = "Q.02", Field = "QcSurf", Opt1 = "OK", Opt2 = "SCRATCH" },
                                            new { Label = "QUALITY RES", Sub = "Q.03", Field = "QcRes", Opt1 = "READ", Opt2 = "UNREAD" }
                                        };
                                    }

                                    @foreach(var qc in qcMetricsLight) {
                                        <div class="d-flex align-items-center justify-content-between p-2 px-3 rounded-3 bg-black bg-opacity-30 border border-white border-opacity-20">
                                            <div class="label-stack">
                                                <span class="label-sub text-info-glow opacity-75" style="font-size: 0.6rem">@qc.Sub</span>
                                                <span class="label-main text-white fw-black" style="font-size: 0.85rem">@qc.Label</span>
                                            </div>
                                            <div class="hud-pill-group" style="width: 170px; height: 38px;">
                                                <label class="hud-pill-item">@qc.Opt1<input type="radio" name="@qc.Field" value="@qc.Opt1"></label>
                                                <label class="hud-pill-item red">@qc.Opt2<input type="radio" name="@qc.Field" value="@qc.Opt2"></label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: DIES DIMENSION - REDESIGNED AS CARDS -->
            <div class="hud-card mb-4 shadow-hud-blue border-white border-opacity-10 overflow-hidden">
                <div class="hud-card-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-rulers hud-card-icon"></i>
                        <span class="hud-card-title">DIES DIMENSION MEASUREMENTS</span>
                    </div>
                    <div class="super-small text-info-glow opacity-50 font-monospace">INTERACTIVE INSTRUMENT PANEL</div>
                </div>
                
                <div class="p-3">
                    <div class="row g-3" id="diesDimensionRow">
                        @{
                            var diesList = new[] { 
                                new { Name = "Nipple", Std = "--", Field = "NippleDieOK", SpecKey = "NippleDie", InitName = "NippleDieInitial", FinalName = "NippleDieFinal" },
                                new { Name = "Tube Die", Std = "--", Field = "TubeDieOK", SpecKey = "TubeDie", InitName = "TubeDieInitial", FinalName = "TubeDieFinal" },
                                new { Name = "Middle Die", Std = "--", Field = "MiddleDieOK", SpecKey = "MiddleDie", InitName = "MiddleDieInitial", FinalName = "MiddleDieFinal" },
                                new { Name = "Cover Die", Std = "--", Field = "CoverDieOK", SpecKey = "CoverDie", InitName = "CoverDieInitial", FinalName = "CoverDieFinal" },
                                new { Name = "Spacer", Std = "--", Field = "SpacerDieOK", SpecKey = "SpacerDie", InitName = "SpacerDieInitial", FinalName = "SpacerDieFinal" },
                                new { Name = "A Distance", Std = "--", Field = "ToleranceDieOK", SpecKey = "ToleranceDie", InitName = "ToleranceInitial", FinalName = "ToleranceFinal" }
                            };
                        }

                        @foreach(var die in diesList) {
                            <div class="col-md-6 col-xl-4 die-container-item" id="die_card_@die.SpecKey">
                                <div class="die-card p-3 rounded-3 border border-white border-opacity-10 bg-black bg-opacity-30 h-100 d-flex flex-column">

                                    <!-- TOP: Instrument name + OK/NG -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="label-stack">
                                            <span class="label-sub">INSTRUMENT</span>
                                            <span class="label-main fs-6">@die.Name</span>
                                        </div>
                                        <div class="hud-pill-group sm" style="width: 100px;">
                                            <label class="hud-pill-item">OK<input type="radio" name="@die.Field" value="true"></label>
                                            <label class="hud-pill-item red">NG<input type="radio" name="@die.Field" value="false"></label>
                                        </div>
                                    </div>

                                    <!-- MIDDLE: Standard min / std / max individual boxes -->
                                    <div class="mb-3" style="display:none;">
                                        <div class="text-center mb-1">
                                            <span style="font-size: 0.48rem; font-weight: 900; letter-spacing: 2px; color: #94a3b8; text-transform: uppercase;">STANDARD</span>
                                        </div>
                                        <div class="d-flex justify-content-center gap-2">
                                            <div class="text-center px-2 py-1 rounded-2" style="border: 1px solid rgba(56,189,248,0.25); min-width: 60px;">
                                                <div style="font-size: 0.42rem; font-weight: 700; letter-spacing: 1px; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px;">min</div>
                                                <div id="spec_min_@die.SpecKey" class="font-monospace fw-bold" style="font-size: 0.8rem; color: #38bdf8;">--</div>
                                            </div>
                                            <div class="text-center px-2 py-1 rounded-2" style="border: 1px solid rgba(125,211,252,0.5); min-width: 60px; background: rgba(56,189,248,0.06);">
                                                <div style="font-size: 0.42rem; font-weight: 700; letter-spacing: 1px; color: #38bdf8; text-transform: uppercase; margin-bottom: 2px;">std</div>
                                                <div id="spec_std_@die.SpecKey" class="font-monospace fw-bold" style="font-size: 0.9rem; color: #7dd3fc;">--</div>
                                            </div>
                                            <div class="text-center px-2 py-1 rounded-2" style="border: 1px solid rgba(56,189,248,0.25); min-width: 60px;">
                                                <div style="font-size: 0.42rem; font-weight: 700; letter-spacing: 1px; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px;">max</div>
                                                <div id="spec_max_@die.SpecKey" class="font-monospace fw-bold" style="font-size: 0.8rem; color: #38bdf8;">--</div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Hidden full spec value for JS validation -->
                                    <div id="spec_@die.SpecKey" style="display:none;">@die.Std</div>

                                    <!-- BOTTOM: Quick-tap for Before & After -->
                                    <div class="mt-auto">
                                        <!-- Hidden actual inputs (sent to server) -->
                                        <input type="hidden" name="@die.InitName" id="die_init_@die.SpecKey" />
                                        <input type="hidden" name="@die.FinalName" id="die_final_@die.SpecKey" />

                                        <!-- Quick Buttons: satu set untuk isi keduanya -->
                                        <div class="die-qt-btn-group" id="die_btns_@die.SpecKey">
                                            <button type="button" class="die-qt-btn die-qt-min" onclick="quickFillDie('@die.SpecKey', '@die.Field', '@die.InitName', '@die.FinalName', 'min')" title="Isi MIN">MIN</button>
                                            <button type="button" class="die-qt-btn die-qt-std" onclick="quickFillDie('@die.SpecKey', '@die.Field', '@die.InitName', '@die.FinalName', 'std')" title="Isi STD">STD</button>
                                            <button type="button" class="die-qt-btn die-qt-max" onclick="quickFillDie('@die.SpecKey', '@die.Field', '@die.InitName', '@die.FinalName', 'max')" title="Isi MAX">MAX</button>
                                            <button type="button" class="die-qt-btn die-qt-ng"  onclick="quickFillDie('@die.SpecKey', '@die.Field', '@die.InitName', '@die.FinalName', 'ng')" title="Nilai NG">NG</button>
                                        </div>
                                        <!-- Selected value display -->
                                        <div class="die-qt-selected" id="die_val_@die.SpecKey" style="display:none;">
                                            <span class="die-qt-val-text" id="die_val_text_@die.SpecKey"></span>
                                            <button type="button" class="qt-clear-btn" onclick="quickClearDie('@die.SpecKey', '@die.Field', '@die.InitName', '@die.FinalName')">&times;</button>
                                        </div>
                                        <!-- Manual input (only when NG) -->
                                        <input type="number" step="any"
                                               id="die_manual_@die.SpecKey"
                                               class="qt-manual-input mt-2"
                                               placeholder="Ketik nilai aktual..."
                                               style="display:none;"
                                               oninput="dieManualInput('@die.SpecKey', '@die.Field', '@die.InitName', '@die.FinalName', this.value)" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <style>
                    .die-card { 
                        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
                        position: relative; 
                        overflow: hidden;
                    }
                    .die-card:hover { 
                        background: rgba(14, 165, 233, 0.08) !important; 
                        border-color: rgba(14, 165, 233, 0.4) !important;
                        transform: translateY(-2px);
                        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                    }
                    .die-card::before {
                        content: '';
                        position: absolute;
                        top: 0; left: 0; width: 3px; height: 100%;
                        background: rgba(255,255,255,0.05);
                        transition: all 0.3s;
                    }
                    .die-card:hover::before {
                        background: var(--hud-primary);
                        box-shadow: 0 0 10px var(--hud-primary);
                    }
                </style>
            </div>

            <!-- SECTION: DYNAMIC PRODUCTION READINGS TABS (CENTERED) -->
            <div class="d-flex flex-column align-items-center mb-5 mt-2">
                <div class="text-info-glow opacity-40 super-small fw-black tracking-widest mb-3" style="font-size: 0.6rem;">DYNAMIC MEASUREMENT CONTROL</div>
                <div class="d-flex align-items-center gap-4">
                    <!-- Tabs Container - Hidden initially, shown after first ADD CHECK -->
                    <div id="readingsTabs" class="d-flex gap-2" style="display: none;">
                        <!-- P-1, P-2, etc. will be injected here -->
                    </div>
                    
                    <!-- ADD CHECK Button - Always Visible -->
                    <div class="add-check-trigger add-check-pulse d-flex align-items-center gap-2 cursor-pointer no-select" onclick="addReadingPoint()">
                        <i class="bi bi-plus-circle fs-3 text-info"></i>
                        <span class="text-white fw-900 tracking-widest" style="font-size: 1.1rem;">ADD CHECK</span>
                    </div>
                </div>
                <!-- Info Text - Hidden initially, shown after first ADD CHECK -->
                <div id="readingsInfoText" class="mt-3 font-monospace super-small opacity-50 text-uppercase tracking-widest no-print d-flex align-items-center gap-2" style="display: none;">
                    <i class="bi bi-info-circle fs-6"></i> <span>SELECT RECORD TO VIEW/EDIT PARAMETERS</span>
                </div>
            </div>

            <style>
                .no-select { user-select: none; }
                .add-check-trigger { 
                    opacity: 1; 
                    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                    padding: 10px 20px;
                    border-radius: 8px;
                    border: 1px solid rgba(13, 202, 240, 0.5);
                    background: rgba(13, 202, 240, 0.05);
                }
                .add-check-trigger:hover { 
                    opacity: 1;
                    background: rgba(13, 202, 240, 0.15);
                    box-shadow: 0 0 15px rgba(13, 202, 240, 0.4);
                    transform: translateY(-2px);
                }
                @@keyframes pulse-border {
                    0%   { box-shadow: 0 0 0 0 rgba(13, 202, 240, 0.5); }
                    70%  { box-shadow: 0 0 0 10px rgba(13, 202, 240, 0); }
                    100% { box-shadow: 0 0 0 0 rgba(13, 202, 240, 0); }
                }
                .add-check-pulse {
                    animation: pulse-border 2s infinite;
                }
                .active-tab { 
                    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%) !important; 
                    color: white !important; 
                    box-shadow: 0 0 25px rgba(14, 165, 233, 0.6) !important; 
                    border-color: #7dd3fc !important;
                    transform: translateY(-3px);
                }
                .reading-tab {
                    min-width: 95px;
                    text-align: center;
                    font-weight: 900;
                    letter-spacing: 1px;
                    cursor: pointer;
                    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                    border: 2px solid rgba(255, 255, 255, 0.12);
                    background: rgba(15, 23, 42, 0.8);
                    border-radius: 10px;
                    backdrop-filter: blur(5px);
                }
                .reading-tab:hover:not(.active-tab) { 
                    border-color: rgba(14, 165, 233, 0.6);
                    background: rgba(14, 165, 233, 0.1);
                    transform: translateY(-2px);
                }
            </style>

            <!-- SECTION: SMART PARAMETER CARDS (ACTIVE RECORD VIEW) -->
            <div class="row g-4 mb-5 d-none" id="parameterCardsContainer">
                @{
                    var monSections = new[] {
                        new { 
                            Title = "SECTION 01: INNER (TUBE 1)", Icon="bi-gear-fill", Color = "#3b82f6", ID="inner",
                            Rows = new[,] { { "Head Temp.", "°C", "HeadTempInner" }, { "Cylinder 1", "°C", "Cylinder1TempInner" }, { "Cylinder 2", "°C", "Cylinder2TempInner" }, { "Cylinder 3", "°C", "Cylinder3TempInner" }, { "Screw Temp.", "°C", "ScrewTempInner" }, { "Screw Speed", "rpm", "ScrewSpeedInner" }, { "Feed Roll Ratio", "%", "FeedRollRatioInner" }, { "Pressure", "MPa", "PressureInner" } }
                        },
                        new { 
                            Title = "SECTION 02: OUTER (COVER)", Icon="bi-shield-shaded", Color = "#f59e0b", ID="outer",
                            Rows = new[,] { { "Head Temp.", "°C", "HeadTempOuter" }, { "Cylinder 1", "°C", "Cylinder1TempOuter" }, { "Cylinder 2", "°C", "Cylinder2TempOuter" }, { "Cylinder 3", "°C", "Cylinder3TempOuter" }, { "Screw Temp.", "°C", "ScrewTempOuter" }, { "Screw Speed", "rpm", "ScrewSpeedOuter" }, { "Feed Roll Ratio", "%", "FeedRollRatioOuter" }, { "Pressure", "MPa", "PressureOuter" } }
                        },
                        new { 
                            Title = "SECTION 03: SPIRAL MECHANISM", Icon="bi-sync", Color = "#10b981", ID="spiral",
                            Rows = new[,] { { "Spiral Speed", "rpm", "SpiralSpeed" }, { "Spiral Pitch (Set)", "mm", "SpiralPitchSetting" }, { "Spiral Pitch (Disp)", "mm", "SpiralPitchDisplay" } } 
                        },
                        new { 
                            Title = "SECTION 04: INFRA & UTILITY", Icon="bi-water", Color = "#0ea5e9", ID="other",
                            Rows = new[,] { { "Preset Value", "Ø mm", "PresetValue" }, { "Control Value", "Ø mm", "ControlValue" }, { "Hose Speed", "m/min", "HoseSpeed" }, { "Take-up Speed", "", "TakeupConveyorSpeed" }, { "Cool Speed", "", "CoolConveyorSpeed" }, { "Conveyor Ratio", "", "ConveyorRatio" }, { "Surface Condition", "", "UnsmoothSurface" }, { "Chiller Temp", "°C", "ChillerWaterTemp" }, { "Caterpillar Gap", "mm", "CaterpillarGap" } } 
                        }
                    };
                }

                @foreach (var mSec in monSections) {
                    <div class="col-12 col-xxl-6">
                        <div class="hud-card h-100 shadow-hud mb-1 overflow-hidden" 
                             style="border: 1px solid @(mSec.Color)44; background: rgba(15, 23, 42, 0.6); box-shadow: 0 0 20px @(mSec.Color)11;">
                            
                            <div class="hud-card-header d-flex justify-content-between align-items-center py-3 px-4" 
                                 style="background: linear-gradient(90deg, @(mSec.Color)33 0%, transparent 100%); border-bottom: 2px solid @(mSec.Color)66;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="p-2 rounded-3" style="background: @(mSec.Color)22; border: 1px solid @(mSec.Color)44;">
                                        <i class="bi @mSec.Icon fs-4" style="color: @mSec.Color"></i>
                                    </div>
                                    <span class="hud-card-title tracking-widest text-white fw-900" style="font-size: 1.1rem; text-shadow: 0 0 10px @(mSec.Color)66;">@mSec.Title</span>
                                </div>
                            </div>
                            
                            <div class="p-4 bg-black bg-opacity-20">
                                <div class="row g-4">
                                    @for (int r = 0; r < mSec.Rows.GetLength(0); r++) {
                                        var key = mSec.Rows[r, 2];
                                        <div class="col-6">
                                            <div class="param-tile-modern rounded-3 p-3 text-center h-100 d-flex flex-column justify-content-between"
                                                 style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s; position: relative; overflow: hidden;">
                                                
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <span class="text-white opacity-60 super-small fw-black tracking-widest">@(mSec.Rows[r, 0].ToUpper())</span>
                                                    <span class="badge rounded-pill super-small" style="background: @(mSec.Color)22; color: @mSec.Color; border: 1px solid @(mSec.Color)44;">@mSec.Rows[r, 1]</span>
                                                </div>
                                                
                                                <div class="std-zone py-2 mb-2 rounded-2" style="display:none;">
                                                    <div class="d-flex justify-content-center gap-1">
                                                        <div class="text-center px-1" style="border-right: 1px solid rgba(255,255,255,0.1); width: 33%;">
                                                            <div style="font-size: 0.4rem; color: #94a3b8; text-transform: uppercase;">min</div>
                                                            <div id="spec_min_@key" class="font-monospace fw-bold" style="font-size: 0.75rem; color: @mSec.Color;">--</div>
                                                        </div>
                                                        <div class="text-center px-1" style="border-right: 1px solid rgba(255,255,255,0.1); width: 33%;">
                                                            <div style="font-size: 0.45rem; color: #fff; text-transform: uppercase;">std</div>
                                                            <div id="spec_std_@key" class="font-monospace fw-bold" style="font-size: 0.85rem; color: @mSec.Color;">--</div>
                                                        </div>
                                                        <div class="text-center px-1" style="width: 33%;">
                                                            <div style="font-size: 0.4rem; color: #94a3b8; text-transform: uppercase;">max</div>
                                                            <div id="spec_max_@key" class="font-monospace fw-bold" style="font-size: 0.75rem; color: @mSec.Color;">--</div>
                                                        </div>
                                                    </div>
                                                    <div id="spec_@key" style="display:none;">--</div>
                                                </div>
                                                
                                                <!-- QUICK-TAP INPUT ZONE -->
                                                <div class="qt-zone" id="qt_zone_@key">
                                                    <!-- Hidden actual input (sent to server) -->
                                                    <input type="hidden" id="input_@key" name="@key"
                                                           onchange="updateReadingData('@key', this.value)" />
                                                    <!-- Quick buttons: MIN / STD / MAX / NG -->
                                                    <div class="qt-btn-group" id="qt_btns_@key">
                                                        <button type="button" class="qt-btn qt-min" onclick="quickFillParam('@key', 'min', '@mSec.Color')" title="Isi nilai MIN">MIN</button>
                                                        <button type="button" class="qt-btn qt-std" onclick="quickFillParam('@key', 'std', '@mSec.Color')" title="Isi nilai STD" style="--qt-color:@mSec.Color">STD</button>
                                                        <button type="button" class="qt-btn qt-max" onclick="quickFillParam('@key', 'max', '@mSec.Color')" title="Isi nilai MAX">MAX</button>
                                                        <button type="button" class="qt-btn qt-ng" onclick="quickFillParam('@key', 'ng', '@mSec.Color')" title="Nilai di luar standar">NG</button>
                                                    </div>
                                                    <!-- Selected value display -->
                                                    <div class="qt-selected" id="qt_val_@key" style="display:none;">
                                                        <span class="qt-val-text" id="qt_val_text_@key"></span>
                                                        <button type="button" class="qt-clear-btn" onclick="quickClearParam('@key')" title="Reset">&times;</button>
                                                    </div>
                                                    <!-- Manual input (only shown when NG) -->
                                                    <input type="number" step="any"
                                                           id="qt_manual_@key"
                                                           class="qt-manual-input"
                                                           placeholder="Ketik nilai aktual..."
                                                           style="display:none; --theme-color:@mSec.Color;"
                                                           oninput="quickManualInput('@key', this.value)" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <style>
                /* ====== QUICK-TAP INPUT SYSTEM ====== */
                .qt-zone { width: 100%; }

                .qt-btn-group {
                    display: flex;
                    flex-direction: row;
                    flex-wrap: wrap;
                    gap: 4px;
                    justify-content: center;
                    width: 100%;
                    align-content: flex-start;
                }
                .qt-btn-group > .qt-btn {
                    flex: 1 1 calc(33.333% - 4px);
                    padding: 10px 4px;
                    border-radius: 8px;
                    font-size: 0.7rem;
                    font-weight: 900;
                    letter-spacing: 1px;
                    border: 1px solid rgba(255,255,255,0.15);
                    background: rgba(255,255,255,0.05);
                    color: #94a3b8;
                    cursor: pointer;
                    transition: all 0.15s;
                    font-family: 'JetBrains Mono', monospace;
                    min-height: 48px;
                }
                .qt-btn-group > .qt-btn.qt-ng {
                    flex: 1 1 100%;
                }
                .qt-btn:hover { transform: translateY(-2px); filter: brightness(1.3); }
                .qt-btn:active { transform: scale(0.94); }
                .qt-btn.qt-std {
                    border-color: var(--qt-color, #38bdf8);
                    color: var(--qt-color, #38bdf8);
                    background: rgba(56,189,248,0.08);
                }
                .qt-btn.qt-min, .qt-btn.qt-max { color: #7dd3fc; }
                .qt-btn.qt-ng {
                    border-color: rgba(239,68,68,0.5);
                    color: #f87171;
                    background: rgba(239,68,68,0.06);
                }
                .qt-btn.qt-active-std {
                    background: var(--qt-color, #38bdf8) !important;
                    color: #020617 !important;
                    border-color: var(--qt-color, #38bdf8) !important;
                    box-shadow: 0 0 12px var(--qt-color, #38bdf8);
                }
                .qt-btn.qt-active-min, .qt-btn.qt-active-max {
                    background: rgba(125,211,252,0.25) !important;
                    color: #fff !important;
                    border-color: #7dd3fc !important;
                }
                .qt-btn.qt-active-ng {
                    background: rgba(239,68,68,0.3) !important;
