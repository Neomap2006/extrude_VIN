                    font-family: 'JetBrains Mono', monospace;
                    font-weight: 900;
                    font-size: 1.6rem;
                    letter-spacing: 1px;
                }
                .qt-val-text.ok { color: #4ade80; }
                .qt-val-text.ng { color: #f87171; }
                .qt-clear-btn {
                    background: rgba(255,255,255,0.1);
                    border: 1px solid rgba(255,255,255,0.2);
                    border-radius: 50%;
                    color: #94a3b8;
                    width: 22px; height: 22px;
                    font-size: 0.85rem;
                    line-height: 1;
                    cursor: pointer;
                    padding: 0;
                    transition: all 0.15s;
                }
                .qt-clear-btn:hover { background: rgba(239,68,68,0.3); color: #f87171; }
                .qt-manual-input {
                    width: 100%;
                    background: rgba(239,68,68,0.08);
                    border: 1px solid rgba(239,68,68,0.4);
                    border-radius: 8px;
                    color: #f87171;
                    text-align: center;
                    font-family: 'JetBrains Mono', monospace;
                    font-weight: 700;
                    font-size: 1.1rem;
                    height: 42px;
                    outline: none;
                    margin-top: 6px;
                    padding: 4px 8px;
                    transition: all 0.2s;
                }
                .qt-manual-input:focus {
                    border-color: #ef4444;
                    box-shadow: 0 0 10px rgba(239,68,68,0.4);
                }
                .qt-manual-input::placeholder { color: rgba(248,113,113,0.5); font-size: 0.75rem; }
                
                .qt-manual-input[data-is-ok="true"] {
                    background: rgba(74,222,128,0.08);
                    border-color: rgba(74,222,128,0.4);
                    color: #4ade80;
