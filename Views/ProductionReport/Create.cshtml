        // ─────────────────────────────────────────────────────────────────────
        // DRAFT AUTO-SAVE / RESTORE  (localStorage per item code)
        // ─────────────────────────────────────────────────────────────────────
        const DRAFT_PREFIX = 'velasto_draft_v1_';
        let _currentDraftItem = null;
        let _autoSaveTimer = null;

        function _draftKey(itemCode) {
            return DRAFT_PREFIX + (itemCode || '').toUpperCase().trim();
        }

        function captureDraft(itemCode) {
            if (!itemCode) return;
            
            // BUGFIX: Sync currently visible inputs to pReadings array before saving draft
            saveCurrentInputsToMemory();
            
            const form = document.getElementById('mainFormContainer');
            if (!form) return;
            const fields = {};
            
            // Capture regular inputs (by ID or NAME for dies dimension)
            form.querySelectorAll('input:not([type="hidden"]):not([type="radio"]):not([type="checkbox"]), select, textarea').forEach(el => {
                if (el.id && el.id !== 'planningSearch') {
                    fields[el.id] = el.value;
                } else if (el.name && !el.id) {
                    // Capture dies dimension inputs (NippleDieInitial, etc) yang hanya punya name
                    fields['__name_' + el.name] = el.value;
                }
            });

            // FIX: Capture hidden dies dimension inputs introduced by the modern UI
            form.querySelectorAll('input[type="hidden"][id^="die_init_"], input[type="hidden"][id^="die_final_"]').forEach(el => {
                fields[el.id] = el.value;
            });
            
            // Capture ALL radio buttons with their state (not just checked ones)
            const radioGroups = {};
            form.querySelectorAll('input[type="radio"]').forEach(el => {
                if (!el.name) return;
                if (!radioGroups[el.name]) {
                    radioGroups[el.name] = { checked: false, value: '' };
                }
                if (el.checked) {
                    radioGroups[el.name] = { checked: true, value: el.value };
                }
            });
            Object.entries(radioGroups).forEach(([name, state]) => {
                if (state.checked) {
                    fields['__radio_' + name] = state.value;
                } else {
                    fields['__radio_' + name] = '__NONE__';
                }
            });
            
            // Capture ALL checkboxes with their state (not just checked ones)
            form.querySelectorAll('input[type="checkbox"]').forEach(el => {
                if (el.name || el.id) {
                    const key = el.name || el.id;
                    fields['__chk_' + key] = el.checked ? (el.value || 'true') : '__UNCHECKED__';
                }
            });
            
            const lots = {};
            ['inner','middle','outer','yarn'].forEach(layer => {
                const c = document.getElementById(layer + '-lot-list');
                if (!c) return;
                lots[layer] = Array.from(c.querySelectorAll('.row')).map(row => ({
                    lot: row.querySelector('input[data-type="lot"]')?.value || '',
                    sg:  row.querySelector('input[data-type="sg"]')?.value  || ''
                })).filter(r => r.lot || r.sg);
            });
            const draft = { ts: Date.now(), fields, lots, readings: JSON.parse(JSON.stringify(pReadings)) };
            try { localStorage.setItem(_draftKey(itemCode), JSON.stringify(draft)); } catch(e) {}
        }

        function restoreDraft(itemCode) {
            const raw = localStorage.getItem(_draftKey(itemCode));
            if (!raw) return false;
            let draft;
            try { draft = JSON.parse(raw); } catch { return false; }
            if (!draft || !draft.fields) return false;
            
            Object.entries(draft.fields).forEach(([id, val]) => {
                if (id.startsWith('__radio_')) {
                    const name = id.replace('__radio_', '');
                    // Uncheck all radios in this group first
                    document.querySelectorAll('input[name="' + name + '"]').forEach(r => r.checked = false);
                    // Then check the saved one
                    if (val !== '__NONE__') {
                        const el = document.querySelector('input[name="' + name + '"][value="' + val + '"]');
                        if (el) el.checked = true;
                    }
                } else if (id.startsWith('__chk_')) {
                    const key = id.replace('__chk_', '');
                    const el = document.querySelector('input[type="checkbox"][name="' + key + '"]') 
                            || document.querySelector('input[type="checkbox"][id="' + key + '"]');
                    if (el) {
                        el.checked = (val !== '__UNCHECKED__');
                    }
                } else if (id.startsWith('__name_')) {
                    // Restore dies dimension inputs by name
                    const name = id.replace('__name_', '');
                    const el = document.querySelector('input[name="' + name + '"]');
                    if (el && !el.readOnly) el.value = val;
                } else {
                    const el = document.getElementById(id);
                    if (el && !el.readOnly) el.value = val;
                }
            });
            
            if (draft.lots) {
                Object.entries(draft.lots).forEach(([layer, rows]) => {
                    if (!rows.length) return;
                    const c = document.getElementById(layer + '-lot-list');
                    if (!c) return;
                    c.innerHTML = '';
                    materialState[layer] = [];
                    rows.forEach(r => {
                        addMaterialRow(layer);
                        const allRows = c.querySelectorAll('.row');
                        const last = allRows[allRows.length - 1];
                        if (last) {
                            const lotEl = last.querySelector('input[data-type="lot"]');
                            const sgEl  = last.querySelector('input[data-type="sg"]');
                            if (lotEl) lotEl.value = r.lot;
                            if (sgEl)  sgEl.value  = r.sg;
                        }
                    });
                });
            }
            
            if (draft.readings && draft.readings.length) {
                pReadings = draft.readings;
                currentReadingIndex = 0; // Default to first reading point
                renderTabs(); // This will show tabs, info text, and parameter cards since pReadings.length > 0
                loadCurrentDataFromMemory(); // Force load data into inputs immediately
            } else {
                // No readings in draft, ensure tabs/cards visibility is correct based on current pReadings
                renderTabs();
            }
            return true;
        }

        function clearDraft(itemCode) {
            try { if (itemCode) localStorage.removeItem(_draftKey(itemCode)); } catch {}
        }

        function showDraftBanner(itemCode, ts) {
            let banner = document.getElementById('draftRestoredBanner');
            if (banner) banner.remove();
            banner = document.createElement('div');
            banner.id = 'draftRestoredBanner';
            banner.style.cssText = 'position:fixed;top:70px;right:24px;z-index:99999;background:linear-gradient(135deg,rgba(16,185,129,0.18),rgba(6,78,59,0.35));border:1px solid rgba(16,185,129,0.5);border-radius:12px;padding:12px 20px;display:flex;align-items:center;gap:12px;box-shadow:0 8px 32px rgba(0,0,0,0.6);backdrop-filter:blur(12px);';
            const age = Math.round((Date.now() - ts) / 60000);
            const ageStr = age < 1 ? 'baru saja' : age + ' mnt lalu';
            banner.innerHTML = '<i class="bi bi-cloud-arrow-down-fill" style="color:#10b981;font-size:1.6rem;"></i>'
                + '<div><div style="color:#10b981;font-weight:900;font-size:0.75rem;letter-spacing:1px;">DRAFT DIPULIHKAN</div>'
                + '<div style="color:#6ee7b7;font-size:0.7rem;">[' + itemCode + '] — disimpan ' + ageStr + '</div></div>'
                + '<button onclick="this.parentElement.remove()" style="background:none;border:none;color:#6ee7b7;font-size:1.1rem;cursor:pointer;margin-left:8px;">✕</button>';
            document.body.appendChild(banner);
            setTimeout(() => { const b = document.getElementById('draftRestoredBanner'); if (b) b.remove(); }, 7000);
        }

        function setupAutoSave(itemCode) {
            _currentDraftItem = itemCode ? itemCode.toUpperCase().trim() : null;
            const form = document.getElementById('mainFormContainer');
            if (!form || !itemCode) return;
            if (form._draftListener) {
                form.removeEventListener('input', form._draftListener);
                form.removeEventListener('change', form._draftListener);
            }
            form._draftListener = () => {
                clearTimeout(_autoSaveTimer);
                _autoSaveTimer = setTimeout(() => captureDraft(_currentDraftItem), 1500);
            };
            form.addEventListener('input', form._draftListener);
            form.addEventListener('change', form._draftListener);
        }

        // BUGFIX: Save draft immediately when leaving the page (beforeunload)
        window.addEventListener('beforeunload', () => {
            if (_currentDraftItem) {
                captureDraft(_currentDraftItem);
            }
        });
        // ─── END DRAFT SYSTEM ─────────────────────────────────────────────────

        // --- PLANNING SEARCH & REFRESH LOGIC ---
        let planningItemsCache = [];
        let planningResultItems = [];
        let planningResultIndex = -1;

        function normalizePlanningShift(shiftValue) {
            if (!shiftValue) return '';
            const raw = shiftValue.toString().trim().toUpperCase();
            const num = raw.replace(/SHIFT/gi, '').trim();
            if (num === '1' || num === 'I' || raw.includes('ONE')) return 'Shift 1';
            if (num === '2' || num === 'II' || raw.includes('TWO')) return 'Shift 2';
            if (num === '3' || num === 'III' || raw.includes('THREE')) return 'Shift 3';
            return shiftValue.toString().trim();
        }

        function applyPlanningShift(shiftValue) {
            const normalized = normalizePlanningShift(shiftValue);
            if (normalized) document.getElementById('Shift').value = normalized;
        }

        async function refreshPlanningItems() {
            const date = document.getElementById('ProductionDate').value;
            const shift = document.getElementById('Shift').value;
            const searchInput = document.getElementById('planningSearch');
            const machine = document.getElementById('MachineName')?.value || window.SESSION_MACHINE_NAME || '';
            
            if (!date || !shift) return;

            searchInput.placeholder = "LOADING PLANNING...";
            searchInput.disabled = true;
            document.getElementById('planningResults').classList.add('d-none');

            try {
                let fromServer = true;
                if (window.db && window.db.apiCache) {
                    const cacheKey = `PLANNING_${date}_${shift}_${machine}`;
                    const cached = await window.db.apiCache.get(cacheKey);
                    if (cached) {
                        planningItemsCache = cached.data;
                        fromServer = false;
                        console.log("Loaded planning items from Dexie Cache");
                    }
                }

                if (fromServer) {
                    let fetchUrl = `/ProductionReport/GetPlanningItems?date=${date}&shift=${encodeURIComponent(shift)}`;
                    if (machine) fetchUrl += `&machine=${encodeURIComponent(machine)}`;
                    const res = await fetch(fetchUrl);
                    planningItemsCache = await res.json();
                    try { localStorage.setItem('offline_planning_cache', JSON.stringify(planningItemsCache)); } catch(e){}
                    
                    if (window.db && window.db.apiCache) {
                        const cacheKey = `PLANNING_${date}_${shift}_${machine}`;
                        await window.db.apiCache.put({ id: cacheKey, data: planningItemsCache, timestamp: new Date().getTime() });
                    }
                    
                    // Silently cache SPS data for these items in the background
                    silentCacheSpsData(planningItemsCache);
                }
                
                // Cek apakah data di-filter berdasarkan mesin
                const isFiltered = planningItemsCache.length > 0 && planningItemsCache[0].isFiltered;
                const machineCtx = planningItemsCache.length > 0 && isFiltered
                    ? ` [${planningItemsCache[0].machineName || 'MESIN'}]`
                    : '';

                searchInput.disabled = false;
                if (planningItemsCache.length > 0) {
                    searchInput.placeholder = `KETIK ITEM CODE (${planningItemsCache.length} TERSEDIA${machineCtx})`;
                } else {
                    searchInput.placeholder = "NO ITEMS IN PLAN FOR THIS MACHINE/DAY";
                }
                searchInput.value = "";
                planningResultItems = planningItemsCache;
                planningResultIndex = -1;
            } catch (e) {
                console.warn("Failed to fetch planning items, trying offline cache:", e);
                const cached = localStorage.getItem('offline_planning_cache');
                if (cached) {
                    try {
                        planningItemsCache = JSON.parse(cached);
                        searchInput.disabled = false;
                        searchInput.placeholder = `[OFFLINE] KETIK ITEM CODE (${planningItemsCache.length} TERSEDIA)`;
                        searchInput.value = "";
                        planningResultItems = planningItemsCache;
                        planningResultIndex = -1;
                        console.log("Loaded planning items from offline cache.");
                        return;
                    } catch(err){}
                }
                searchInput.placeholder = "ERROR LOADING DATA (OFFLINE)";
            }
        }

        function openPlanningDropdown() {
            // Clear the displayed text so user sees the dropdown fresh
            const searchInput = document.getElementById('planningSearch');
            searchInput.value = '';
            searchInput.readOnly = false;
            const isFiltered = planningItemsCache.length > 0 && planningItemsCache[0].isFiltered;
            const machineCtx = isFiltered && planningItemsCache[0].machineName ? ` [${planningItemsCache[0].machineName}]` : '';

            searchInput.placeholder = planningItemsCache.length > 0
                ? `KETIK ITEM CODE (${planningItemsCache.length} TERSEDIA${machineCtx})`
                : 'LOADING...';

            const container = document.getElementById('planningResults');
            filterPlanningResults('');
            container.classList.remove('d-none');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const container = document.getElementById('planningResults');
            const searchInput = document.getElementById('planningSearch');

            if (container && !container.contains(e.target) && e.target !== searchInput) {
                container.classList.add('d-none');
                // Restore label text if a planning was already selected
                if (window._selectedPlanningLabel) {
                    searchInput.value = window._selectedPlanningLabel;
                    searchInput.readOnly = true;
                }
            }
        });

        async function silentCacheSpsData(items) {
            if (!navigator.onLine || !window.db || !window.db.apiCache) return;
            
            const machine = document.getElementById('MachineName')?.value || '';
            const uniqueItems = [...new Set(items.map(i => i.itemCode))].filter(Boolean);
            
            for (const code of uniqueItems) {
                const upperCode = code.toUpperCase().trim();
                try {
                    const cachedSps = await window.db.apiCache.get(`SPS_PARAM_${upperCode}`);
                    if (!cachedSps) {
                        const res = await fetch(`/ProductionReport/GetSpsByItem?itemCode=${encodeURIComponent(code.trim())}&machineCode=${encodeURIComponent(machine)}`);
                        if (!res.ok) continue;
                        const data = await res.json();
                        // Cache it regardless of success (if success is false, it means Protocol Not Found)
                        await window.db.apiCache.put({ 
                            id: `SPS_PARAM_${upperCode}`, 
                            data: data, 
                            timestamp: new Date().getTime() 
                        });
                        try { localStorage.setItem('offline_param_sps_cache_' + upperCode, JSON.stringify(data)); } catch(e){}
                    }
                } catch (e) {
                    console.warn("Silent cache failed for", code, e);
                }
            }
        }

        function filterPlanningResults(query) {
            const sanitizedQuery = query.trim().toUpperCase();
            const results = sanitizedQuery.length === 0 ? planningItemsCache : planningItemsCache.filter(item => 
                (item.itemCode && item.itemCode.toUpperCase().includes(sanitizedQuery)) || 
                (item.itemName && item.itemName.toUpperCase().includes(sanitizedQuery))
            );

            planningResultItems = results;
            planningResultIndex = -1;
            renderResults(results, sanitizedQuery.length === 0);
        }

        function renderResults(items, showAll = false) {
            const container = document.getElementById('planningResults');
            container.innerHTML = "";
            
            if (items.length === 0) {
                container.innerHTML = `<div class="p-3 text-white-50 super-small font-monospace">--- NO TACTICAL MATCH FOUND ---</div>`;
                container.classList.remove('d-none');
                return;
            }

            items.forEach((item, index) => {
                const hasSps = item.hasSps === true;
                const spsBadge = hasSps
                    ? `<span style="font-size:10px;font-weight:900;color:#10b981;background:rgba(16,185,129,0.15);padding:2px 9px;border-radius:20px;border:1px solid rgba(16,185,129,0.4);white-space:nowrap;letter-spacing:0.5px;">
                            <i class="bi bi-check-circle-fill me-1"></i>SPS ✓
                       </span>`
                    : `<span style="font-size:10px;font-weight:900;color:#ef4444;background:rgba(239,68,68,0.12);padding:2px 9px;border-radius:20px;border:1px solid rgba(239,68,68,0.35);white-space:nowrap;letter-spacing:0.5px;">
                            <i class="bi bi-x-circle-fill me-1"></i>NO SPS
                       </span>`;

                const borderColor = hasSps ? 'rgba(16,185,129,0.5)' : 'rgba(239,68,68,0.35)';

                const div = document.createElement('div');
                div.className = "p-3 border-bottom border-white border-opacity-5 cursor-pointer transition-all planning-result-item";
                div.style.cssText = `background:rgba(15,23,42,0.98); border-left:3px solid ${borderColor} !important;`;
                div.dataset.index = index;
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <div class="d-flex flex-column gap-1" style="min-width:0; flex:1;">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="text-info-glow fw-900 font-monospace" style="font-size: 1.1rem; letter-spacing: 1px;">[${item.itemCode}]</span>
                                ${item.machineName ? `<span style="font-size:10px; font-weight:800; color:#f59e0b; background:rgba(245,158,11,0.15); padding:2px 8px; border-radius:20px; white-space:nowrap;"><i class="bi bi-cpu-fill"></i> ${item.machineName}</span>` : ''}
                                ${spsBadge}
                            </div>
                            <span class="text-white small opacity-80 fw-bold">${item.itemName}</span>
                        </div>
                        <div class="text-end flex-shrink-0">
                            <div class="super-small text-info opacity-50 fw-black tracking-widest mb-1">PLANNING MASTER</div>
                            <div class="badge bg-info bg-opacity-10 border border-info border-opacity-20 text-info fw-bold font-monospace" style="font-size: 0.65rem;">
                                ${item.dateShift ? item.dateShift : 'NO DATE'}
                            </div>
                        </div>
                    </div>
                `;
                div.onclick = () => selectPlanningItem(item);
                div.onmouseenter = () => highlightPlanningResult(index);
                container.appendChild(div);
            });

            container.classList.remove('d-none');
        }

        function highlightPlanningResult(index) {
            const container = document.getElementById('planningResults');
            const options = Array.from(container.querySelectorAll('.planning-result-item'));
            if (!options.length) return;
            options.forEach(opt => opt.classList.remove('planning-result-highlight'));
            const target = options[index];
            if (target) {
                target.classList.add('planning-result-highlight');
                planningResultIndex = index;
                target.scrollIntoView({ block: 'nearest' });
            }
        }

        function selectPlanningItem(item) {
            console.log("SELECTED ITEM DATA:", item); // Debugging
            
            // Tampilkan hanya kode item + nama mesin (ringkas)
            const displayText = item.machineName
                ? `[${item.itemCode}] ${item.machineName}`
                : `[${item.itemCode}]`;

            const searchInput = document.getElementById('planningSearch');
            searchInput.value = displayText;
            searchInput.readOnly = true;
            searchInput.style.cursor = 'pointer';
            window._selectedPlanningLabel = displayText;   // store for restore on blur
            document.getElementById('planningResults').classList.add('d-none');
            
            // Auto-sync Date
            if (item.DateProduction) {
                const pDate = item.DateProduction.split('T')[0];
                document.getElementById('ProductionDate').value = pDate;
            } else if (item.date) {
                document.getElementById('ProductionDate').value = item.date;
            }

            // Auto-sync Shift from planning
            if (item.Shift || item.shift) {
                applyPlanningShift(item.Shift || item.shift);
            }

            // Pre-fill ItemCode immediately as safety net (async fetchSpsByItem may override via applySpsToForm)
            const itemCodeEl = document.getElementById('ItemCode');
            if (itemCodeEl && item.itemCode) itemCodeEl.value = item.itemCode;

            fetchSpsByItem(item.itemCode, item.machineName || item.machineCode);
        }

        function lockForm() {
            const container = document.getElementById('mainFormContainer');
            const wrapper = document.getElementById('formContentBlurWrapper');

            // Re-add overlay if it was removed
            if (container && !document.getElementById('formLockOverlay')) {
                const overlay = document.createElement('div');
                overlay.id = 'formLockOverlay';
                overlay.className = 'd-flex flex-column align-items-center justify-content-center';
                overlay.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:20px;z-index:1000;background:rgba(2,6,23,0.75);border-radius:12px;';
                overlay.innerHTML = `
                    <div class="text-center p-5 rounded-4 border border-danger border-opacity-30 shadow" style="background:rgba(15,23,42,0.95);">
                        <div class="mb-4"><i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:4rem;filter:drop-shadow(0 0 20px rgba(239,68,68,0.6));"></i></div>
                        <h2 class="text-white fw-900 tracking-widest mb-2" style="font-size:1.4rem;">SPS TIDAK DITEMUKAN</h2>
                        <p class="text-danger opacity-75 super-small mb-0 tracking-widest uppercase">Pilih planning lain yang sudah<br>memiliki SPS Masterlist terdaftar.</p>
                    </div>`;
                container.style.minHeight = '450px';
                container.style.pointerEvents = 'none';
                container.prepend(overlay);
            }

            // Hide the form content
            if (wrapper) {
                wrapper.style.display = 'none';
            }

            // Reset planning selection so user must pick again
            const searchInput = document.getElementById('planningSearch');
            if (searchInput) {
                searchInput.value = '';
                searchInput.readOnly = true;
                searchInput.placeholder = 'PILIH PLANNING MASTER...';
                searchInput.blur();
            }
            window._selectedPlanningLabel = null;
        }

        async function fetchSpsByItem(code, forcedMachine = null) {
            const normalCode = (code || '').toUpperCase().trim();

            // Save draft for previous item before switching
            if (_currentDraftItem && _currentDraftItem !== normalCode) {
                captureDraft(_currentDraftItem);
            }

            try {
                let data = null;
                let fromServer = true;
                const machine = forcedMachine || document.getElementById('MachineName')?.value || '';

                if (window.db && window.db.apiCache) {
                    const cachedSps = await window.db.apiCache.get(`SPS_PARAM_${code.toUpperCase().trim()}`);
                    if (cachedSps) {
                        data = cachedSps.data;
                        fromServer = false;
                        console.log("Loaded SPS PARAM master from Dexie Cache");
                    }
                }

                if (fromServer) {
                    const res = await fetch(`/ProductionReport/GetSpsByItem?itemCode=${encodeURIComponent(code.trim())}&machineCode=${encodeURIComponent(machine)}`);
                    data = await res.json();
                    if (data.success === false) throw new Error('PROTOCOL NOT FOUND');
                    try { localStorage.setItem('offline_param_sps_cache_' + code, JSON.stringify(data)); } catch(e){}
                } else {
                    if (data.success === false) throw new Error('PROTOCOL NOT FOUND');
                }

                const hasDraft = localStorage.getItem(_draftKey(normalCode));

                applySpsToForm(data);  // unlock form + fill SPS defaults

                if (hasDraft) {
                    // Restore draft after a short render delay, then re-trigger validators
                    setTimeout(() => {
                        let d; try { d = JSON.parse(hasDraft); } catch {}
                        const restored = restoreDraft(normalCode);
                        if (restored && d) {
                            showDraftBanner(normalCode, d.ts);
                            revalidateAllInputs();  // restore OK/NG coloring
                        }
                    }, 200);
                } else {
                    // No draft: ensure tabs/cards visibility is correct based on current pReadings
                    renderTabs();
                }

                setupAutoSave(normalCode);  // begin tracking changes

            } catch (e) {
                console.warn("fetchSpsByItem error:", e);
                
                if (e.message !== 'PROTOCOL NOT FOUND') {
                    const cached = localStorage.getItem('offline_param_sps_cache_' + code);
                    if (cached) {
                        try {
                            const data = JSON.parse(cached);
                            applySpsToForm(data);
                            const hasDraft = localStorage.getItem(_draftKey(normalCode));
                            if (hasDraft) {
                                setTimeout(() => {
                                    let d; try { d = JSON.parse(hasDraft); } catch {}
                                    const restored = restoreDraft(normalCode);
                                    if (restored && d) {
                                        showDraftBanner(normalCode, d.ts);
                                        revalidateAllInputs();
                                    }
                                }, 200);
                            } else {
                                renderTabs();
                            }
                            setupAutoSave(normalCode);
                            Swal.fire({ title: 'OFFLINE MODE', text: 'Standar parameter dimuat dari memori lokal.', icon: 'info', timer: 2000, toast: true, position: 'top-end', showConfirmButton: false });
                            return;
                        } catch(err){}
                    }
                }

                if (e.message === 'PROTOCOL NOT FOUND') {
                    lockForm();
                    Swal.fire({
                        title: 'PROTOCOL UNKNOWN',
                        text: `SPS Masterlist untuk item [${code}] belum terdaftar. Form dikunci — silakan pilih item lain.`,
                        icon: 'warning',
                        background: '#020617',
                        color: '#f87171',
                        confirmButtonColor: '#ef4444',
                        confirmButtonText: 'PILIH ULANG'
                    });
                } else {
                    lockForm();
                    Swal.fire({
                        title: 'SYSTEM ERROR',
                        text: `Terjadi kesalahan saat memproses data SPS: ${e.message} (Anda sedang offline dan item ini belum pernah diakses sebelumnya).`,
                        icon: 'error',
                        background: '#020617',
                        color: '#f87171',
                        confirmButtonColor: '#ef4444',
                        confirmButtonText: 'OK'
                    });
                }
            }
        }


        document.addEventListener('DOMContentLoaded', () => {
            renderTabs();
            refreshPlanningItems();
            
            const searchInput = document.getElementById('planningSearch');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => filterPlanningResults(e.target.value));
                searchInput.addEventListener('focus', () => openPlanningDropdown());
            }

            // Auto-show Middle card if current machine is CHS 3 Layer
            const mName = (window.SESSION_MACHINE_NAME || '').toLowerCase();
            const isMachine3L = mName.includes('3l') || mName.includes('chs3') || mName.includes('3 layer') || mName.includes('3layer');
            if (isMachine3L) {
                const middleCard = document.getElementById('middleMaterialCard');
                if (middleCard) middleCard.style.display = '';
            }

            // Initial hide check for Middle Die Card
            const machineHidden = document.getElementById('MachineName')?.value || '';
            const navbarMachine = Array.from(document.querySelectorAll('.navbar-right .text-warning.fw-bold'))
                                     .map(el => el.textContent.trim())
                                     .find(txt => txt.length > 0) || '';
            const isDoubleLayer = (machineHidden + navbarMachine).toUpperCase().includes('DL');
            if (isDoubleLayer) {
                const midCard = document.getElementById('die_card_MiddleDie');
                if (midCard) {
                    midCard.classList.add('d-none');
                    midCard.style.setProperty('display', 'none', 'important');
                }
                const yarnCard = document.getElementById('yarnMaterialCard');
                if (yarnCard) {
                    yarnCard.classList.add('d-none');
                    yarnCard.style.setProperty('display', 'none', 'important');
                }
            }
        });
        function resetHUD() {
            // 1. Reset Arrays & State - START WITH EMPTY (consistent with new behavior)
            pReadings = [];
            currentReadingIndex = -1;
            
            // 2. Clear All Form Inputs
            const form = document.getElementById('mainReportForm');
            if (form) {
                // Clear text inputs, number, selects (Except metadata)
                form.querySelectorAll('input:not([type="hidden"]), select, textarea').forEach(inp => {
                    const id = inp.id;
                    if (id === 'ProductionDate' || id === 'Shift' || id === 'CreatedBy') return; 
                    inp.value = "";
                });
                
                // Reset planningSearch to default state
                const ps = document.getElementById('planningSearch');
                if (ps) {
                    ps.value = '';
                    ps.readOnly = true;
                    ps.placeholder = 'PILIH PLANNING MASTER...';
                }
                window._selectedPlanningLabel = null;

                // Clear Radios
                form.querySelectorAll('input[type="radio"]').forEach(rad => rad.checked = false);
                
                // Clear validation classes
                form.querySelectorAll('.valid-success, .valid-error').forEach(el => el.classList.remove('valid-success', 'valid-error'));
            }

            // 3. Clear Dynamic Material Lots
            ['inner', 'outer', 'yarn', 'middle'].forEach(layer => {
                const container = document.getElementById(`${layer}-lot-list`);
                if (container) container.innerHTML = "";
                materialState[layer] = [];
            });

            // 4. Reset Planning Search & Manual Search
            const pSearch = document.getElementById('planningSearch');
            const mSearch = document.getElementById('manualItemSearch');
            if (pSearch) pSearch.value = "";
            if (mSearch) mSearch.value = "";
            document.getElementById('SpsId').value = "";

            // 5. Re-lock the form UI
            const wrapper = document.getElementById('formContentBlurWrapper');
            const container = document.getElementById('mainFormContainer');
            
            // Re-inject Lock Overlay if it was removed
            if (!document.getElementById('formLockOverlay')) {
                const overlay = document.createElement('div');
                overlay.id = 'formLockOverlay';
                overlay.className = 'd-flex flex-column align-items-center justify-content-center';
                overlay.style = "position: absolute; top:0; left:0; right:0; bottom:20px; z-index: 1000; background: rgba(2, 6, 23, 0.65); border-radius: 12px; backdrop-filter: none !important; -webkit-backdrop-filter: none !important;";
                overlay.innerHTML = `
                    <div class="text-center p-5 rounded-4 border border-info border-opacity-30 shadow-hud-blue" style="background: rgba(15, 23, 42, 0.95);">
                        <div class="mb-4">
                            <i class="bi bi-shield-lock-fill text-info" style="font-size: 5rem; filter: drop-shadow(0 0 20px rgba(14, 165, 233, 0.6));"></i>
                        </div>
                        <h2 class="text-white fw-900 tracking-widest mb-2" style="font-size: 1.5rem;">FORM LOCKED</h2>
                        <p class="text-info opacity-70 super-small mb-0 tracking-widest uppercase">PLEASE SELECT PLANNING MASTER<br/>OR MANUAL PROTOCOL TO REVEAL DATA ENTRY</p>
                    </div>
                `;
                container.prepend(overlay);
            }

            if (wrapper) {
                wrapper.style.display = 'none';
                wrapper.classList.remove('animate__fadeInUp');
            }
            if (container) {
                container.style.minHeight = '450px';
                container.style.pointerEvents = 'none';
            }

            // Hide measurement sections (consistent with new behavior)
            const tabsContainer = document.getElementById('readingsTabs');
            const infoText = document.getElementById('readingsInfoText');
            const paramCards = document.getElementById('parameterCardsContainer');
            if (tabsContainer) tabsContainer.style.display = 'none';
            if (infoText) infoText.style.display = 'none';
            if (paramCards) paramCards.classList.add('d-none');

            // 6. UI Updates
            renderTabs();
            refreshPlanningItems();

            Swal.fire({
                icon: 'success',
                title: 'HUD RESET',
                text: 'Dashboard is ready for new production command.',
                timer: 1500,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }


    </script>
