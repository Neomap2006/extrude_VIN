                .die-qt-btn.die-qt-min, .die-qt-btn.die-qt-max { color: #7dd3fc; }
                .die-qt-btn.die-qt-ng { border-color: rgba(239,68,68,0.5); color: #f87171; background: rgba(239,68,68,0.06); }
                .die-qt-btn.die-qt-active-ok { background: #38bdf8 !important; color: #020617 !important; border-color: #38bdf8 !important; box-shadow: 0 0 10px #38bdf8; }
                .die-qt-btn.die-qt-active-ng { background: rgba(239,68,68,0.3) !important; color: #fff !important; border-color: #ef4444 !important; box-shadow: 0 0 10px rgba(239,68,68,0.5); }
                .die-qt-selected {
