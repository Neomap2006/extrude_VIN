        // --- PARAMETER VALIDATION LOGIC ---
        // --- PARAMETER VALIDATION LOGIC ---
        function computeValidity(valStr, specText) {
            // Replace comma with dot for validation
            const normalizedVal = valStr.replace(',', '.');
            const val = parseFloat(normalizedVal);
            if (valStr === "" || isNaN(val) || !specText || specText === '--') return true;

            let isValid = true;
            try {
                // Pipe-separated "min | std | max" format (e.g. "25,70 | 25,80 | 25,90")
                if (specText.includes('|')) {
                    const rawParts = specText.split('|').map(s => s.trim());
                    const sMin = rawParts[0];
                    const sStd = rawParts[1] || '';
                    const sMax = rawParts[rawParts.length - 1];

                    const pMin = parseFloat(sMin.replace(',', '.'));
                    const pMax = parseFloat(sMax.replace(',', '.'));

                    const hasMinLimit = !isNaN(pMin);
                    const hasMaxLimit = !isNaN(pMax);

                    if (hasMinLimit && hasMaxLimit) return (val >= pMin && val <= pMax);
                    if (hasMinLimit) return (val >= pMin);
                    if (hasMaxLimit) return (val <= pMax);

                    // If neither MIN nor MAX is a number, fallback to STD string logic (e.g. "Max 120")
                    specText = sStd;
                }

                // Normalize specText as well (replace comma with dot)
                let workingText = specText.replace(',', '.').replace(/max\.?/i, '').replace(/min\.?/i, '').replace(/[A-Za-z°%]/g, '').trim();

                if (specText.includes('±')) {
                    const parts = specText.replace(',', '.').split('±');
                    const target = parseFloat(parts[0].replace(/[^-0-9.]/g, ''));
                    const tolerance = parseFloat(parts[1].replace(/[^-0-9.]/g, ''));
                    if (!isNaN(target) && !isNaN(tolerance)) {
                        isValid = (val >= (target - tolerance) && val <= (target + tolerance));
                    }
                } else if (specText.toLowerCase().includes('max')) {
                    const limit = parseFloat(workingText.replace(/[^-0-9.]/g, ''));
                    if (!isNaN(limit)) isValid = (val <= limit);
                } else if (specText.toLowerCase().includes('min')) {
                    const limit = parseFloat(workingText.replace(/[^-0-9.]/g, ''));
                    if (!isNaN(limit)) isValid = (val >= limit);
                } else if (specText.includes('-') && !specText.startsWith('-')) {
                    // Range logic (e.g. 10-14)
                    const rangeParts = specText.split('-');
                    const min = parseFloat(rangeParts[0].replace(',', '.').replace(/[^-0-9.]/g, ''));
                    const max = parseFloat(rangeParts[1].replace(',', '.').replace(/[^-0-9.]/g, ''));
                    if (!isNaN(min) && !isNaN(max)) {
                        isValid = (val >= min && val <= max);
                    }
                } else {
                    const target = parseFloat(workingText.replace(/[^-0-9.]/g, ''));
                    if(!isNaN(target)) isValid = (val === target);
                }
            } catch (e) { isValid = false; }
            return isValid;
        }

        function validateParam(input, specId) {
            const specEl = document.getElementById(specId);
            if(!specEl) return;
            const specText = specEl.innerText.trim();
            const isValid = computeValidity(input.value.trim(), specText);
            
            if (input.value.trim() === "") {
                input.classList.remove('valid-success', 'valid-error');
                return;
            }

            if (isValid) {
                input.classList.add('valid-success');
                input.classList.remove('valid-error');
            } else {
                input.classList.add('valid-error');
                input.classList.remove('valid-success');
            }
        }

        // ====== QUICK-TAP DYNAMIC GENERATOR ======
        function generateSteps(minStr, stdStr, maxStr) {
            // --- RANGE FORMAT: "5-8" or "5,0-8,0" passed as stdStr ---
            // Detect when stdStr itself contains a dash/tilde between two numbers
            const rangeMatch = stdStr && String(stdStr).trim().match(/^([\d,.]+)\s*[-–~]\s*([\d,.]+)$/);
            if (rangeMatch) {
                const rangeMin = parseFloat(rangeMatch[1].replace(',', '.'));
                const rangeMax = parseFloat(rangeMatch[2].replace(',', '.'));
                if (!isNaN(rangeMin) && !isNaN(rangeMax) && rangeMin < rangeMax) {
                    // Determine decimal places from the range string parts
                    const part1Dec = (rangeMatch[1].includes(',') ? rangeMatch[1].split(',')[1] : (rangeMatch[1].includes('.') ? rangeMatch[1].split('.')[1] : '')).length;
                    const part2Dec = (rangeMatch[2].includes(',') ? rangeMatch[2].split(',')[1] : (rangeMatch[2].includes('.') ? rangeMatch[2].split('.')[1] : '')).length;
                    const decimalsToUse = Math.max(part1Dec, part2Dec);
                    const diff = rangeMax - rangeMin;
                    // For integer ranges (like 5-8), step by 1. For decimal ranges, step by 0.5 or smaller.
                    const stepSize = decimalsToUse === 0 ? 1 : (diff > 5 ? Math.ceil(diff / 10) : 0.5);
                    const stepCount = Math.min(Math.round(diff / stepSize), 20);
                    const stepValue = diff / stepCount;
                    const values = [];
                    for (let i = 0; i <= stepCount; i++) {
                        values.push(rangeMin + stepValue * i);
                    }
                    const fmt = v => v.toFixed(decimalsToUse).replace('.', ',');
                    const unique = [...new Set(values.map(v => Number(v.toFixed(3))))].sort((a, b) => a - b);
                    return { steps: unique.map(v => fmt(v)), rangeMin: fmt(rangeMin), rangeMax: fmt(rangeMax), isRange: true };
                }
            }

            const min = parseFloat((minStr || '').replace(',', '.'));
            const std = parseFloat((stdStr || '').replace(',', '.'));
            const max = parseFloat((maxStr || '').replace(',', '.'));
            
            if (isNaN(std)) return stdStr && stdStr !== '--' && stdStr !== '---' ? { steps: [stdStr], isRange: false } : { steps: [], isRange: false };
            if (isNaN(min) || isNaN(max) || min === max) return { steps: [stdStr], isRange: false };
            
            const diff = max - min;
            // Generate up to 10 intervals (11 points) for finer control
            const intervals = 10;
            const stepValue = diff / intervals;
            
            const values = [];
            for (let i = 0; i <= intervals; i++) {
                values.push(min + (stepValue * i));
            }
            // Ensure STD is included exactly
            values.push(std);
            
            // Determine display formatting based on std string
            const stdDecimals = (stdStr.split(/[.,]/)[1] || '').length;
            const format = v => {
                const decimalsToUse = stdDecimals > 0 ? stdDecimals + 1 : 1;
                let s = v.toFixed(decimalsToUse);
                
                // Trim trailing zero if unnecessary
                if (s.endsWith('.0') && stdDecimals === 0) s = s.slice(0, -2);
                else if (s.endsWith('0') && s.includes('.')) {
                    if (s.split('.')[1].length > Math.max(1, stdDecimals)) {
                       s = s.slice(0, -1);
                    }
                }
                return s.replace('.', ',');
            };
            
            // Filter unique values and format
            const uniqueVals = [...new Set(values.map(v => Number(v.toFixed(3))))].sort((a, b) => a - b);
            return { steps: uniqueVals.map(v => format(v)), isRange: false };
        }

        function renderDynamicButtons(key, finalMin, finalStd, finalMax) {
            const result = generateSteps(finalMin, finalStd, finalMax);
            const steps = result.steps;
            const isRange = result.isRange;
            const rangeMin = result.rangeMin;
            const rangeMax = result.rangeMax;

            if (steps.length === 0) return;

            // Section 01-04
            const qtBtns = document.getElementById('qt_btns_' + key);
            if (qtBtns) {
                // If only 1 step (max-only or min-only spec), render 2 buttons: OK (Manual Input) and NG (Manual Input)
                if (steps.length === 1 && !isRange) {
                    const limitLabel = finalStd || steps[0];
                    const btnStyle = "font-size: 0.65rem; padding: 6px 2px;";
                    const html = `
                        <div style="margin-bottom:4px; font-size:0.55rem; color:#94a3b8; font-weight:700; letter-spacing:1px; text-transform:uppercase; text-align:center;">MAX: ${limitLabel}</div>
                        <div style="display:flex; flex-direction:column; gap:4px; width:100%;">
                            <button type="button" class="qt-btn qt-std" style="${btnStyle} width:100%;" onclick="quickFillParamDynamic('${key}', 'ok_manual', false, this)">OK (Manual Input)</button>
                            <button type="button" class="qt-btn qt-ng" style="${btnStyle} width:100%;" onclick="quickFillParamDynamic('${key}', 'ng', false, this)">NG (Manual Input)</button>
                        </div>
                    `;
                    qtBtns.innerHTML = html;
                    
                    const themeColor = qtBtns.closest('.param-tile-modern')?.querySelector('.vibrant-hud-input')?.style.getPropertyValue('--theme-color');
                    if(themeColor) qtBtns.style.setProperty('--qt-color', themeColor);
                    
                    return;
                }

                const btnStyle = "font-size: 0.65rem; padding: 6px 2px;";
                
                // Header label for range specs
                if (isRange) {
                    qtBtns.insertAdjacentHTML('beforebegin', `<div id="rangelabel_${key}" style="margin-bottom:4px; font-size:0.55rem; color:#94a3b8; font-weight:700; letter-spacing:1px; text-transform:uppercase; text-align:center;">STD: ${rangeMin} – ${rangeMax}</div>`);
                }

                let html = '<div style="display:flex; flex-wrap:wrap; gap:4px; justify-content:center; width:100%;">';
                steps.forEach(val => {
                    let isStd = false;
                    let btnClass = 'qt-btn qt-min';
                    let label = '&nbsp;';

                    if (isRange) {
                        // In range mode: MIN and MAX label at edges, all are valid (qt-std color)
                        if (val === rangeMin) { label = 'MIN'; btnClass = 'qt-btn qt-min'; }
                        else if (val === rangeMax) { label = 'MAX'; btnClass = 'qt-btn qt-max'; }
                        else { btnClass = 'qt-btn qt-std'; }
                    } else {
                        isStd = (val === finalStd);
                        btnClass = isStd ? 'qt-btn qt-std' : 'qt-btn qt-min';
                        if (val === finalMin) label = 'MIN';
                        else if (val === finalMax) label = 'MAX';
                        else if (val === finalStd) label = 'STD';
                    }
                    
                    html += `<button type="button" class="${btnClass}" style="${btnStyle} flex: 1 1 calc(33% - 4px); min-width: 50px; display:flex; flex-direction:column; align-items:center; justify-content:center; line-height:1.2;" onclick="quickFillParamDynamic('${key}', '${val}', ${isStd}, this)">
                        <span style="font-size:0.5rem; opacity:0.6; font-weight:normal; letter-spacing:0.5px;">${label}</span>
                        <span>${val}</span>
                    </button>`;
                });
                html += `</div>`;
                html += `<div style="margin-top:2px;"><button type="button" class="qt-btn qt-ng" style="${btnStyle} width:100%;" onclick="quickFillParamDynamic('${key}', 'ng', false, this)">NG (Manual Input)</button></div>`;
                qtBtns.innerHTML = html;
                
                const themeColor = qtBtns.closest('.param-tile-modern')?.querySelector('.vibrant-hud-input')?.style.getPropertyValue('--theme-color');
                if(themeColor) qtBtns.style.setProperty('--qt-color', themeColor);
            }

            // Dies Dimension
            const dieBtns = document.getElementById('die_btns_' + key);
            if (dieBtns) {
                const dieRadios = {
                    'NippleDie': { field: 'NippleDieOK', init: 'NippleDieInitial', final: 'NippleDieFinal' },
                    'TubeDie': { field: 'TubeDieOK', init: 'TubeDieInitial', final: 'TubeDieFinal' },
                    'MiddleDie': { field: 'MiddleDieOK', init: 'MiddleDieInitial', final: 'MiddleDieFinal' },
                    'CoverDie': { field: 'CoverDieOK', init: 'CoverDieInitial', final: 'CoverDieFinal' },
                    'SpacerDie': { field: 'SpacerDieOK', init: 'SpacerDieInitial', final: 'SpacerDieFinal' },
                    'ToleranceDie': { field: 'ToleranceDieOK', init: 'ToleranceInitial', final: 'ToleranceFinal' }
                };
                const d = dieRadios[key];
                if (d) {
                    const btnStyle = "font-size: 0.65rem; padding: 6px 2px;";
                    
                    let html = '';
                    // Header label for range specs
                    if (isRange) {
                        html += `<div style="margin-bottom:4px; font-size:0.55rem; color:#94a3b8; font-weight:700; letter-spacing:1px; text-transform:uppercase; text-align:center;">STD: ${rangeMin} – ${rangeMax}</div>`;
                    }
                    html += '<div style="display:flex; flex-wrap:wrap; gap:4px; justify-content:center; width:100%;">';
                    steps.forEach(val => {
                        let isStd = false;
                        let btnClass = 'die-qt-btn die-qt-min';
                        let label = '&nbsp;';

                        if (isRange) {
                            if (val === rangeMin) { label = 'MIN'; btnClass = 'die-qt-btn die-qt-min'; }
                            else if (val === rangeMax) { label = 'MAX'; btnClass = 'die-qt-btn die-qt-max'; }
                            else { isStd = true; btnClass = 'die-qt-btn die-qt-std'; }
                        } else {
                            isStd = (val === finalStd);
                            btnClass = isStd ? 'die-qt-btn die-qt-std' : 'die-qt-btn die-qt-min';
                            if (val === finalMin) label = 'MIN';
                            else if (val === finalMax) label = 'MAX';
                            else if (val === finalStd) label = 'STD';
                        }
                        
                        html += `<button type="button" class="${btnClass}" style="${btnStyle} flex: 1 1 calc(33% - 4px); min-width: 50px; display:flex; flex-direction:column; align-items:center; justify-content:center; line-height:1.2;" onclick="quickFillDieDynamic('${key}', '${d.field}', '${d.init}', '${d.final}', '${val}', ${isStd}, this)">
                            <span style="font-size:0.45rem; opacity:0.6; font-weight:normal; letter-spacing:0.5px;">${label}</span>
                            <span>${val}</span>
                        </button>`;
                    });
                    html += `</div>`;
                    html += `<div style="margin-top:2px;"><button type="button" class="die-qt-btn die-qt-ng" style="${btnStyle} width:100%;" onclick="quickFillDieDynamic('${key}', '${d.field}', '${d.init}', '${d.final}', 'ng', false, this)">NG</button></div>`;
                    dieBtns.innerHTML = html;
                }
            }
        }

        // ====== QUICK-TAP PARAM (Section 01-04) ======
        function quickFillParamDynamic(key, val, isStd, btnEl) {
            const hiddenInput = document.getElementById('input_' + key);
            const valDisplay  = document.getElementById('qt_val_' + key);
            const valText     = document.getElementById('qt_val_text_' + key);
            const btnsDiv     = document.getElementById('qt_btns_' + key);
            const manualInput = document.getElementById('qt_manual_' + key);
            if (!hiddenInput) return;

            // Reset active states
            if (btnsDiv) btnsDiv.querySelectorAll('.qt-btn').forEach(b => {
                b.classList.remove('qt-active-std', 'qt-active-min', 'qt-active-ng');
            });

            // Hide the button grid because a selection was made
            if (btnsDiv) btnsDiv.style.display = 'none';

            if (val === 'ng' || val === 'ok_manual') {
                hiddenInput.value = '';
                if (valDisplay) valDisplay.style.display = 'flex'; // show for the X button
                if (valText) { 
                    valText.textContent = (val === 'ok_manual') ? 'OK' : 'NG'; 
                    valText.className = (val === 'ok_manual') ? 'qt-val-text ok' : 'qt-val-text ng'; 
                }
                if (manualInput) { 
                    manualInput.style.display = 'block'; 
                    manualInput.setAttribute('data-is-ok', val === 'ok_manual' ? 'true' : 'false');
                    manualInput.focus(); 
                }
                if (btnEl) btnEl.classList.add(val === 'ok_manual' ? 'qt-active-std' : 'qt-active-ng');
                updateReadingData(key, '');
                return;
            }

            if (manualInput) { manualInput.style.display = 'none'; manualInput.value = ''; }
            
            hiddenInput.value = val;
            updateReadingData(key, val);

            const activeClass = isStd ? 'qt-active-std' : 'qt-active-min';
            if (btnEl) btnEl.classList.add(activeClass);

            if (valText) { valText.textContent = val; valText.className = 'qt-val-text ok'; }
            if (valDisplay) valDisplay.style.display = 'flex';
        }

        function quickClearParam(key) {
            const hiddenInput = document.getElementById('input_' + key);
            const valDisplay  = document.getElementById('qt_val_' + key);
            const btnsDiv     = document.getElementById('qt_btns_' + key);
            const manualInput = document.getElementById('qt_manual_' + key);
            if (hiddenInput) hiddenInput.value = '';
            if (valDisplay) valDisplay.style.display = 'none';
            if (manualInput) { manualInput.style.display = 'none'; manualInput.value = ''; }
            if (btnsDiv) {
                btnsDiv.style.display = 'flex'; // show the grid again
                btnsDiv.querySelectorAll('.qt-btn').forEach(b => {
                    b.classList.remove('qt-active-std','qt-active-min','qt-active-max','qt-active-ng');
                });
            }
            updateReadingData(key, '');
        }

        function quickManualInput(key, val) {
            const hiddenInput = document.getElementById('input_' + key);
            const valDisplay  = document.getElementById('qt_val_' + key);
            const valText     = document.getElementById('qt_val_text_' + key);
            const manualInput = document.getElementById('qt_manual_' + key);
            
            if (hiddenInput) hiddenInput.value = val;
            
            if (valText) { 
                const isOk = manualInput && manualInput.getAttribute('data-is-ok') === 'true';
                valText.textContent = val || (isOk ? 'OK' : 'NG'); 
                valText.className = isOk ? 'qt-val-text ok' : 'qt-val-text ng'; 
            }
            if (valDisplay) valDisplay.style.display = 'flex';
            updateReadingData(key, val);
        }

        // ====== QUICK-TAP DIES (Before & After shared) ======
        function quickFillDieDynamic(specKey, radioField, initName, finalName, val, isStd, btnEl) {
            const initInput  = document.getElementById('die_init_' + specKey);
            const finalInput = document.getElementById('die_final_' + specKey);
            const valDisplay = document.getElementById('die_val_' + specKey);
            const valText    = document.getElementById('die_val_text_' + specKey);
            const btnsDiv    = document.getElementById('die_btns_' + specKey);
            const manualInput = document.getElementById('die_manual_' + specKey);

            if (btnsDiv) btnsDiv.querySelectorAll('.die-qt-btn').forEach(b => {
                b.classList.remove('die-qt-active-ok', 'die-qt-active-ng');
            });

            // Hide the button grid because a selection was made
            if (btnsDiv) btnsDiv.style.display = 'none';

            if (val === 'ng') {
                if (initInput)  initInput.value = '';
                if (finalInput) finalInput.value = '';
                if (valDisplay) valDisplay.style.display = 'flex';
                if (valText) { valText.textContent = 'NG'; valText.className = 'die-qt-val-text ng'; }
                if (manualInput) { manualInput.style.display = 'block'; manualInput.value = ''; manualInput.focus(); }
                if (btnEl) btnEl.classList.add('die-qt-active-ng');
                
                const radios = document.getElementsByName(radioField);
                for(let r of radios) { r.checked = (r.value === 'false'); }
                return;
            }

            if (manualInput) { manualInput.style.display = 'none'; manualInput.value = ''; }

            if (initInput)  initInput.value = val;
            if (finalInput) finalInput.value = val;

            const radios = document.getElementsByName(radioField);
            for(let r of radios) { r.checked = (r.value === 'true'); }

            if (btnEl) btnEl.classList.add('die-qt-active-ok');

            if (valText) { valText.textContent = val; valText.className = 'die-qt-val-text ok'; }
            if (valDisplay) valDisplay.style.display = 'flex';
            triggerAutoSave();
        }

        function dieManualInput(specKey, radioField, initName, finalName, val) {
            const initInput  = document.getElementById('die_init_' + specKey);
            const finalInput = document.getElementById('die_final_' + specKey);
            const valDisplay = document.getElementById('die_val_' + specKey);
            const valText    = document.getElementById('die_val_text_' + specKey);
            if (initInput)  initInput.value = val;
            if (finalInput) finalInput.value = val;
            // Always NG when manually typed
            const radios = document.getElementsByName(radioField);
            for(let r of radios) { r.checked = (r.value === 'false'); }
            if (valText) { valText.textContent = val || 'NG'; valText.className = 'die-qt-val-text ng'; }
            if (valDisplay) valDisplay.style.display = 'flex';
            triggerAutoSave();
        }

        function quickClearDie(specKey, radioField, initName, finalName) {
            const initInput  = document.getElementById('die_init_' + specKey);
            const finalInput = document.getElementById('die_final_' + specKey);
            const valDisplay = document.getElementById('die_val_' + specKey);
            const btnsDiv    = document.getElementById('die_btns_' + specKey);
            const manualInput = document.getElementById('die_manual_' + specKey);
            if (initInput)  initInput.value = '';
            if (finalInput) finalInput.value = '';
            if (valDisplay) valDisplay.style.display = 'none';
            if (manualInput) { manualInput.style.display = 'none'; manualInput.value = ''; }
            if (btnsDiv) {
                btnsDiv.style.display = 'flex';
                btnsDiv.querySelectorAll('.die-qt-btn').forEach(b => {
                    b.classList.remove('die-qt-active-ok','die-qt-active-ng');
                });
            }
            const radios = document.getElementsByName(radioField);
            for(let r of radios) { r.checked = false; }
            triggerAutoSave();
        }

        function syncAllModernUIs() {
            // Sync Parameters
            document.querySelectorAll('#parameterCardsContainer input[id^="input_"]').forEach(inp => {
                const key = inp.id.replace('input_', '');
                const val = inp.value.trim();
                const btnsDiv = document.getElementById('qt_btns_' + key);
                const valDisplay = document.getElementById('qt_val_' + key);
                const valText = document.getElementById('qt_val_text_' + key);
                const manualInput = document.getElementById('qt_manual_' + key);
                
                if (val !== '') {
                    if (btnsDiv) btnsDiv.style.display = 'none';
                    if (valDisplay) valDisplay.style.display = 'flex';
                    if (valText) {
                        valText.textContent = val;
                        const isNg = inp.classList.contains('valid-error');
                        valText.className = isNg ? 'qt-val-text ng' : 'qt-val-text ok';
                    }
                    if (manualInput) manualInput.style.display = 'none';
                } else {
                    if (btnsDiv) {
                        btnsDiv.style.display = 'flex';
                        btnsDiv.querySelectorAll('.qt-btn').forEach(b => {
                            b.classList.remove('qt-active-std', 'qt-active-min', 'qt-active-max', 'qt-active-ng');
                        });
                    }
                    if (valDisplay) valDisplay.style.display = 'none';
                    if (manualInput) {
                        manualInput.style.display = 'none';
                        manualInput.value = '';
                    }
                }
            });

            // Sync Dies
            document.querySelectorAll('input[id^="die_init_"]').forEach(inp => {
                const specKey = inp.id.replace('die_init_', '');
                const val = inp.value.trim();
                const btnsDiv = document.getElementById('die_btns_' + specKey);
                const valDisplay = document.getElementById('die_val_' + specKey);
                const valText = document.getElementById('die_val_text_' + specKey);
                const manualInput = document.getElementById('die_manual_' + specKey);
                
                if (val !== '') {
                    if (btnsDiv) btnsDiv.style.display = 'none';
                    if (valDisplay) valDisplay.style.display = 'flex';
                    if (valText) {
                        valText.textContent = val;
                        const radioOk = document.querySelector(`input[name="${specKey}OK"][value="true"]`);
                        const isOk = radioOk && radioOk.checked;
                        valText.className = isOk ? 'die-qt-val-text ok' : 'die-qt-val-text ng';
                    }
                    if (manualInput) manualInput.style.display = 'none';
                } else {
                    if (btnsDiv) {
                        btnsDiv.style.display = 'flex';
                        btnsDiv.querySelectorAll('.die-qt-btn').forEach(b => {
                            b.classList.remove('die-qt-active-ok', 'die-qt-active-ng');
                        });
                    }
                    if (valDisplay) valDisplay.style.display = 'none';
                    if (manualInput) {
                        manualInput.style.display = 'none';
                        manualInput.value = '';
                    }
                }
            });
        }

        function revalidateAllInputs() {
            // Re-trigger oninput on all inputs that have validators attached
            // This restores OK/NG coloring after a programmatic value restore (draft)
            const form = document.getElementById('mainFormContainer');
            if (!form) return;
            form.querySelectorAll('input[oninput], select[oninput]').forEach(el => {
                if (el.value !== '') {
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                }
            });
            form.querySelectorAll('select[onchange]').forEach(el => {
                el.dispatchEvent(new Event('change', { bubbles: true }));
            });
            syncAllModernUIs();
        }

        function checkDieStatus(specId, radioFieldName, initName, finalName) {
            const initInp = document.querySelector(`[name="${initName}"]`);
            const finalInp = document.querySelector(`[name="${finalName}"]`);
            const specEl = document.getElementById(specId);
            if(!specEl) return;
            const specText = specEl.innerText.trim();
            if(specText === '--' || specText === '---') return;

            // FIX: Jika kedua input kosong, reset status OK/NG menjadi netral
            if (!initInp.value && !finalInp.value) {
                const radios = document.getElementsByName(radioFieldName);
                radios.forEach(r => r.checked = false);
                initInp.classList.remove('valid-success', 'valid-error');
                finalInp.classList.remove('valid-success', 'valid-error');
                return;
            }

            let isInitOk = true;
            let isFinalOk = true;

            if(initInp && initInp.value) isInitOk = computeValidity(initInp.value, specText);
            if(finalInp && finalInp.value) isFinalOk = computeValidity(finalInp.value, specText);

            // Styling
            if(initInp) {
                if(!initInp.value) initInp.classList.remove('valid-success', 'valid-error');
                else { initInp.classList.toggle('valid-success', isInitOk); initInp.classList.toggle('valid-error', !isInitOk); }
            }
            if(finalInp) {
                if(!finalInp.value) finalInp.classList.remove('valid-success', 'valid-error');
                else { finalInp.classList.toggle('valid-success', isFinalOk); finalInp.classList.toggle('valid-error', !isFinalOk); }
            }

            // Radio logic: Source of truth is BOTH (if any is NG, overall is NG. If only one has value, that one decides)
            let overallOk = true;
            if(initInp.value && finalInp.value) overallOk = isInitOk && isFinalOk;
            else if(initInp.value) overallOk = isInitOk;
            else if(finalInp.value) overallOk = isFinalOk;

            const radios = document.getElementsByName(radioFieldName);
            if (radios.length > 0) {
                for(let r of radios) {
                    if(r.value === 'true') r.checked = overallOk;
                    if(r.value === 'false') r.checked = !overallOk;
                }
            }
        }

        function toggleSingleDetail(key) {
            const drawer = document.getElementById('detail_' + key);
            const icon = document.getElementById('icon_' + key);
            drawer.classList.toggle('d-none');
            icon.parentElement.classList.toggle('active');
        }

        function toggleAllDetails(sectionId) {
            const container = document.getElementById('body_' + sectionId);
            if(!container) return;
            const drawers = container.querySelectorAll('.detail-drawer');
            const buttons = container.querySelectorAll('.btn-detail-toggle');
            
            let isOpening = false;
            for(let d of drawers) { if(d.classList.contains('d-none')) { isOpening = true; break; } }

            drawers.forEach(d => isOpening ? d.classList.remove('d-none') : d.classList.add('d-none'));
            buttons.forEach(b => isOpening ? b.classList.add('active') : b.classList.remove('active'));
        }

        // --- DYNAMIC READINGS MANAGEMENT (MODERNIZED) ---
        let currentReadingIndex = -1; // -1 means no active tab
        let pReadings = []; // Start with empty array, will be populated when user clicks ADD CHECK

        function addReadingPoint() {
            // Show the tabs and info text if this is the first check
            if (pReadings.length === 0) {
                const tabsContainer = document.getElementById('readingsTabs');
                const infoText = document.getElementById('readingsInfoText');
                const paramCards = document.getElementById('parameterCardsContainer');
                
                if (tabsContainer) {
                    tabsContainer.style.display = 'flex';
                    tabsContainer.classList.add('animate__animated', 'animate__fadeIn');
                }
                
                if (infoText) {
                    infoText.style.display = 'flex';
                    infoText.classList.add('animate__animated', 'animate__fadeIn');
                }
                
                if (paramCards) {
                    paramCards.classList.remove('d-none');
                    paramCards.classList.add('animate__animated', 'animate__fadeInUp');
                }
            }

            saveCurrentInputsToMemory();

            const now = new Date();
            const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            const nextId = pReadings.length;
            
            pReadings.push({
                id: nextId,
                label: `P-${nextId + 1}`,
                time: timeStr,
                data: {}
            });
            
            switchReadingTab(nextId);
            triggerAutoSave();
        }

        function switchReadingTab(index) {
            saveCurrentInputsToMemory();
            currentReadingIndex = index;
            renderTabs();
            loadCurrentDataFromMemory();
            triggerAutoSave();
        }

        function saveCurrentInputsToMemory() {
            if (currentReadingIndex === -1) return;
            const activeData = pReadings[currentReadingIndex].data;
            const inputElements = document.querySelectorAll('#parameterCardsContainer input[id^="input_"]');
            inputElements.forEach(inp => {
                const key = inp.id.replace('input_', '');
                activeData[key] = inp.value;
            });
        }

        function loadCurrentDataFromMemory() {
            if (currentReadingIndex === -1) return;
            const activeData = pReadings[currentReadingIndex].data;
            const inputElements = document.querySelectorAll('#parameterCardsContainer input[id^="input_"]');
            inputElements.forEach(inp => {
                const key = inp.id.replace('input_', '');
                inp.value = activeData[key] || '';
                validateParam(inp, 'spec_' + key);
            });
            syncAllModernUIs();
        }

        function renderTabs() {
            const container = document.getElementById('readingsTabs');
            const infoText = document.getElementById('readingsInfoText');
            const paramCards = document.getElementById('parameterCardsContainer');
            if(!container) return;
            
            // Show/hide tabs container, info text, and parameter cards based on whether there are tabs
            if (pReadings.length > 0) {
                container.style.display = 'flex';
                if (infoText) infoText.style.display = 'flex';
                if (paramCards) paramCards.classList.remove('d-none');
            } else {
                container.style.display = 'none';
                if (infoText) infoText.style.display = 'none';
                if (paramCards) paramCards.classList.add('d-none');
            }
            
            container.innerHTML = pReadings.map((p, idx) => `
                <div class="btn btn-hud-outline reading-tab py-1 px-3 d-flex flex-column align-items-center rounded ${idx === currentReadingIndex ? 'active-tab' : ''}" 
                     style="position: relative;" onclick="switchReadingTab(${idx})">
                    <button type="button" class="btn p-0 text-danger border-0 shadow-none" 
                            style="position: absolute; top: -8px; right: -8px; z-index: 10; background: #020617; border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center;" 
                            onclick="event.stopPropagation(); removeReadingPoint(${idx})">
                        <i class="bi bi-x-circle-fill" style="font-size: 0.9rem;"></i>
                    </button>
                    <span style="font-size: 0.6rem; opacity: 0.6;">${p.label}</span>
                    <span class="small fw-bold">${p.time}</span>
                </div>
            `).join('');
        }

        function removeReadingPoint(index) {
            // Allow deletion of first tab now (since user must explicitly add tabs)
            if (pReadings.length === 1 && index === 0) {
                Swal.fire({
                    title: 'DELETE LAST CHECK?',
                    text: 'This will hide the measurement inputs.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#334155',
                    confirmButtonText: 'YES, DELETE',
                    background: '#020617',
                    color: '#fff'
                }).then((result) => {
                    if (result.isConfirmed) {
                        pReadings = [];
                        currentReadingIndex = -1;
                        renderTabs();
                        
                        // Hide tabs, info text, and param cards when no tabs remain
                        const tabsContainer = document.getElementById('readingsTabs');
                        const infoText = document.getElementById('readingsInfoText');
                        const paramCards = document.getElementById('parameterCardsContainer');
                        if (tabsContainer) tabsContainer.style.display = 'none';
                        if (infoText) infoText.style.display = 'none';
                        if (paramCards) paramCards.classList.add('d-none');
                    }
                });
                return;
            }
            
            Swal.fire({
                title: 'DELETE CHECK POINT?',
                text: `Remove ${pReadings[index].label} and its data?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#334155',
                confirmButtonText: 'YES, DELETE',
                background: '#020617',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    pReadings.splice(index, 1);
                    // Re-label all points
                    pReadings.forEach((p, i) => { p.label = `P-${i + 1}`; });
                    
                    // Adjust current focus
                    if (currentReadingIndex >= pReadings.length) {
                        currentReadingIndex = pReadings.length - 1;
                    } else if (currentReadingIndex === index) {
                        currentReadingIndex = Math.max(0, index - 1);
                    }
                    
                    // Hide sections if no tabs remain
                    if (pReadings.length === 0) {
                        currentReadingIndex = -1;
                        const tabsContainer = document.getElementById('readingsTabs');
                        const infoText = document.getElementById('readingsInfoText');
                        const paramCards = document.getElementById('parameterCardsContainer');
                        if (tabsContainer) tabsContainer.style.display = 'none';
                        if (infoText) infoText.style.display = 'none';
                        if (paramCards) paramCards.classList.add('d-none');
                    }
                    
                    renderTabs();
                    loadCurrentDataFromMemory();
                    triggerAutoSave();
                }
            });
        }

        function triggerAutoSave() {
            const form = document.getElementById('mainFormContainer');
            if (form) form.dispatchEvent(new Event('input', { bubbles: true }));
        }

        function updateReadingData(key, value) {
            if (pReadings[currentReadingIndex]) {
                pReadings[currentReadingIndex].data[key] = value;
                triggerAutoSave();
            }
        }

        // --- DYNAMIC MATERIAL LOT MANAGEMENT ---
        const materialState = {
            inner: [],
            outer: [],
            middle: [],
            yarn: []
        };

        function showStdSuggestion(stdId, actId, dropdownId) {
            const stdVal = document.getElementById(stdId).value;
            const dd = document.getElementById(dropdownId);
            if (!stdVal || stdVal === '---' || stdVal === '') {
                dd.style.display = 'none';
                return;
            }
            
            dd.innerHTML = `
                <div class="std-suggestion-item" onclick="selectStdSuggestion('${actId}', '${stdVal}', '${dropdownId}')">
                    <span class="std-suggestion-label">USE STANDARD:</span>
                    ${stdVal}
                </div>
            `;
            dd.style.display = 'block';
        }

        function selectStdSuggestion(actId, val, dropdownId) {
            document.getElementById(actId).value = val;
            hideStdSuggestion(dropdownId);
        }

        function hideStdSuggestion(dropdownId) {
            setTimeout(() => {
                const dd = document.getElementById(dropdownId);
                if (dd) dd.style.display = 'none';
            }, 200);
        }

        function addMaterialRow(layer) {
            const listContainer = document.getElementById(`${layer}-lot-list`);
            const index = materialState[layer].length;
            
            if (index >= 10) {
                Swal.fire('PROCESS LIMIT', 'System supports a maximum of 10 batch lots per production cycle.', 'warning');
                return;
            }

            const rowId = `lot-${layer}-${Date.now()}`;
            const isYarn = (layer === 'yarn');
            const themeColor = layer === 'inner' ? 'info' : (layer === 'outer' ? 'warning' : (layer === 'middle' ? 'purple' : 'success'));
            const themeRgb = layer === 'inner' ? '14, 165, 233' : (layer === 'outer' ? '245, 158, 11' : (layer === 'middle' ? '167, 139, 250' : '16, 185, 129'));
            const themeHex = layer === 'inner' ? '#38bdf8' : (layer === 'outer' ? '#f59e0b' : (layer === 'middle' ? '#c4b5fd' : '#10b981'));
            
            const div = document.createElement('div');
            div.id = rowId;
            div.className = `row g-1 align-items-center animate__animated animate__fadeInLeft mb-2`;
            div.innerHTML = `
                <div class="${isYarn ? 'col-10' : 'col-6'}">
                    <div class="hud-scan-group p-1" style="border-color: rgba(${themeRgb}, 0.25);">
                        <input type="text" class="hud-input-scan fw-bold w-100" style="font-size: 0.75rem; color: ${themeHex};" placeholder="LOT #${index + 1}..." data-layer="${layer}" data-type="lot" />
                        <button type="button" class="hud-scan-btn ms-1" style="color: ${themeHex};" onclick="openScannerForDynamicRow('${rowId}')"><i class="bi bi-upc-scan fs-6"></i></button>
                    </div>
                </div>
                ${!isYarn ? `
                <div class="col-4">
                    <div class="d-flex flex-column" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(${themeRgb}, 0.3); border-radius: 6px; padding: 2px 8px;">
                        <label class="font-black opacity-50 mb-0" style="font-size: 0.55rem; letter-spacing: 0.5px; color: ${themeHex};">SG VALUE</label>
                        <div class="d-flex align-items-center">
                            <span class="fw-900 me-1" style="font-size: 0.65rem; opacity: 0.6; color: ${themeHex};">🧪</span>
                            <input type="number" step="0.0001" class="hud-input font-monospace fw-black p-0 border-0 bg-transparent text-end flex-grow-1" style="font-size: 1rem; color: ${themeHex};" placeholder="0.0000" data-layer="${layer}" data-type="sg" />
                        </div>
                    </div>
                </div>
                ` : ''}
                <div class="col-2 text-center" style="min-width: 40px;">
                    <button type="button" onclick="removeMaterialRow('${layer}', '${rowId}')" class="btn btn-link text-danger p-0 border-0 shadow-none" title="REMOVE LOT">
                        <i class="bi bi-x-circle-fill fs-5"></i>
                    </button>
                </div>
            `;
            
            listContainer.appendChild(div);
            materialState[layer].push(rowId);
        }

        function removeMaterialRow(layer, rowId) {
            const el = document.getElementById(rowId);
            if (el) {
                el.classList.replace('animate__fadeInLeft', 'animate__fadeOutRight');
                setTimeout(() => {
                    el.remove();
                    materialState[layer] = materialState[layer].filter(id => id !== rowId);
                    triggerAutoSave();
                }, 300);
            }
        }

        function openScannerForDynamicRow(rowId) {
            const input = document.getElementById(rowId).querySelector('input[data-type="lot"]');
            openScannerCustom((code) => {
                input.value = code;
                input.classList.add('blink-once');
            });
        }

        function openScannerCustom(callback) {
            const modalEl = document.getElementById('scannerModal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            setTimeout(() => {
                try {
                    html5QrCode = new Html5Qrcode("reader");
                    const config = { fps: 10, qrbox: { width: 220, height: 220 } };

                    html5QrCode.start({ facingMode: "environment" }, config, (decodedText) => {
                        callback(decodedText);
                        closeScannerModal();
                        // Optional beep sound could be added here
                    }).catch(err => {
                        console.error("Scanner failed (environment)", err);
                        // Try fallback to any camera
                        html5QrCode.start({ facingMode: "user" }, config, (decodedText) => {
                            callback(decodedText);
                            closeScannerModal();
                        }).catch(err2 => {
                            closeScannerModal();
                            Swal.fire('CAMERA ERROR', 'Kamera tidak ditemukan atau izin tidak diberikan.', 'error');
                        });
                    });
                } catch(e) {
                    closeScannerModal();
                    Swal.fire('SYSTEM ERROR', 'Modul Scanner belum dimuat sempurna. Harap refresh halaman.', 'error');
                }
            }, 300);
        }

        function closeScannerModal() {
            const modalEl = document.getElementById('scannerModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (html5QrCode && html5QrCode.isScanning) {
                html5QrCode.stop().then(() => {
                    modal.hide();
                }).catch(() => modal.hide());
            } else {
                modal.hide();
            }
        }

        function getMaterialLotPayload() {
            const results = [];
            const layerIdMap = {
                inner: { std: 'InnerMaterial',  actual: 'InnerMaterialActual' },
                outer: { std: 'OuterMaterial',  actual: 'OuterMaterialActual' },
                middle: { std: 'MiddleMaterial', actual: 'MiddleMaterialActual' },
                yarn:  { std: 'Yarn',           actual: 'YarnActual' }
            };

            ['inner', 'outer', 'middle', 'yarn'].forEach(layer => {
                const container = document.getElementById(`${layer}-lot-list`);
                if (!container) return;
                const rows = container.querySelectorAll('.row');
                const ids = layerIdMap[layer];
                rows.forEach(row => {
                    const lot = row.querySelector('input[data-type="lot"]').value;
                    const sgInput = row.querySelector('input[data-type="sg"]');
                    const sg = sgInput ? sgInput.value.replace(',', '.') : null;
                    
                    if (lot || sg) {
                        results.push({
                            LayerType: layer.toUpperCase(),
                            MaterialName: document.getElementById(ids.std)?.value || '',
                            MaterialActual: document.getElementById(ids.actual)?.value || '',
                            LotNumber: lot,
                            SGValue: sg ? parseFloat(sg) : null
                        });
                    }
                });
            });
            return results;
        }

