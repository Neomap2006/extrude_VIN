                .die-qt-btn-group {
                    display: flex;
                    flex-direction: column;
                    gap: 4px;
                    justify-content: center;
                    width: 100%;
                }
                .die-qt-btn {
                    flex: 1;
                    padding: 8px 4px;
                    border-radius: 6px;
                    font-size: 0.65rem;
                    font-weight: 900;
                    letter-spacing: 1px;
                    border: 1px solid rgba(255,255,255,0.15);
                    background: rgba(255,255,255,0.05);
                    color: #94a3b8;
                    cursor: pointer;
                    transition: all 0.15s;
                    font-family: 'JetBrains Mono', monospace;
