@model VelastoProductionSystem.Models.SpsNoDoc

@{
    ViewData["Title"] = "Standard Parameter Setting - " + Model.DocumentNumber;
    Layout = "_Layout";
}

@functions {
    string FormatVal(string? strVal, decimal? min, decimal? asli, decimal? max)
    {
        if (asli.HasValue && min.HasValue && max.HasValue)
        {
            var tolPlus = max.Value - asli.Value;
            var tolMinus = asli.Value - min.Value;
            if (tolPlus > 0 && Math.Abs(tolPlus - tolMinus) < 0.001m)
            {
                return $"{FormatNum(asli.Value)} ± {FormatNum(tolPlus)}";
            }
            else if (tolPlus > 0 || tolMinus > 0)
            {
                return $"{FormatNum(asli.Value)} (+{FormatNum(tolPlus)} / -{FormatNum(tolMinus)})";
            }
            return FormatNum(asli.Value);
        }
        
        if (!string.IsNullOrWhiteSpace(strVal))
        {
            return strVal.Trim();
        }

        if (asli.HasValue) return FormatNum(asli.Value);
        if (min.HasValue && max.HasValue) return $"{FormatNum(min.Value)} ~ {FormatNum(max.Value)}";
        if (max.HasValue) return $"Max {FormatNum(max.Value)}";
        if (min.HasValue) return $"Min {FormatNum(min.Value)}";

        return "-";
    }

    string FormatNum(decimal val)
    {
        if (val == Math.Round(val)) return val.ToString("0");
        return val.ToString("0.##");
    }

    string FormatTension(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return "-";
        val = val.Trim();
        if (!val.EndsWith("g", StringComparison.OrdinalIgnoreCase))
        {
            val += " g";
        }
        return val;
    }

    string FormatMesh(string? dim, string? screen, decimal? dimAsli = null)
    {
        var d = !string.IsNullOrWhiteSpace(dim) ? dim.Trim() : (dimAsli.HasValue ? "Ø" + FormatNum(dimAsli.Value) : "");
        var s = !string.IsNullOrWhiteSpace(screen) ? screen.Trim() : "";
        if (!string.IsNullOrEmpty(d) && !string.IsNullOrEmpty(s)) return $"{d} {s}";
        if (!string.IsNullOrEmpty(d)) return d;
        if (!string.IsNullOrEmpty(s)) return s;
        return "-";
    }
}

<style>
    /* SPS Standard Document Styles matching VI-SOP-PROD-131 */
    .sps-container {
        width: 100%;
        background: #4a4a4a;
        padding: 20px 0;
        min-height: 100vh;
    }

    .sps-document {
        background: white;
        color: black;
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 8mm 10mm;
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
        font-family: Arial, Helvetica, sans-serif;
        font-size: 7pt;
        line-height: 1.15;
        box-sizing: border-box;
    }

    /* HEADER */
    .sps-header-wrap {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        border-bottom: 2px solid #000;
        padding-bottom: 4px;
        margin-bottom: 4px;
    }

    .sps-logo-section {
        width: 120px;
        display: flex;
        align-items: center;
    }

    .sps-logo {
        max-width: 110px;
        height: auto;
        display: block;
    }

    .sps-title-center {
        flex: 1;
        text-align: center;
        padding: 0 10px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .sps-title-center h1 {
        font-size: 13pt;
        font-weight: 900;
        margin: 0 0 2px 0;
        text-decoration: underline;
        letter-spacing: 0.3px;
        text-transform: none;
    }

    .sps-title-center p {
        font-size: 8pt;
        font-weight: bold;
        margin: 0;
    }

    /* SIGNATURE BOX */
    .sps-sign-box {
        width: 175px;
        border: 1px solid #000;
        display: flex;
        flex-direction: column;
    }

    .sps-sign-grid {
        display: flex;
        height: 100%;
    }

    .sps-sign-col {
        flex: 1;
        border-right: 1px solid #000;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: center;
        padding: 2px;
    }

    .sps-sign-col:last-child {
        border-right: none;
    }

    .sps-sign-title {
        font-size: 6.5pt;
        font-weight: bold;
        border-bottom: 1px solid #000;
        padding-bottom: 2px;
    }

    .sps-sign-space {
        height: 32px;
    }

    .sps-sign-name {
        font-size: 6pt;
        line-height: 1;
    }

    /* INFO SECTION */
    .sps-info-grid {
        display: flex;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 7.5pt;
    }

    .sps-info-left {
        flex: 1.1;
        display: grid;
        grid-template-columns: 85px 12px 1fr;
        row-gap: 1.5px;
        align-items: center;
    }

    .sps-info-left .lbl {
        font-weight: bold;
    }

    .sps-info-left .val {
        font-weight: normal;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sps-info-right {
        flex: 1;
    }

    .sps-rev-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 6.5pt;
    }

    .sps-rev-table th, .sps-rev-table td {
        border: 1px solid #000;
        padding: 1.5px 3px;
        text-align: center;
    }

    .sps-rev-table th {
        background-color: #f2f2f2;
        font-weight: bold;
    }

    /* HOSE SPEC BOX */
    .sps-hose-box {
        border: 1px solid #000;
        padding: 3px 6px;
        margin-bottom: 5px;
        font-size: 7pt;
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        line-height: 1.25;
    }

    .sps-hose-content {
        flex: 1;
    }

    .sps-hose-legend {
        border-left: 1px solid #000;
        padding-left: 6px;
        margin-left: 6px;
        font-size: 6pt;
        min-width: 110px;
        line-height: 1.15;
    }

    .sps-hose-legend-title {
        font-weight: bold;
        text-decoration: underline;
        margin-bottom: 1px;
    }

    /* MAIN PARAMETER TABLE */
    .sps-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 6.2pt;
        margin-bottom: 4px;
    }

    .sps-table th, .sps-table td {
        border: 1px solid #000;
        padding: 1.5px 2px;
        vertical-align: middle;
        text-align: center;
    }

    .sps-table thead th {
        background-color: #f0f0f0;
        font-weight: bold;
        line-height: 1.1;
        font-size: 6pt;
    }

    .sps-table td.text-left {
        text-align: left;
        padding-left: 4px;
    }

    .sps-table td.item-name {
        text-align: left;
        font-weight: bold;
        padding-left: 3px;
    }

    .sps-table td.sub-item {
        text-align: left;
        padding-left: 4px;
    }

    .sps-table td.class-cell {
        font-size: 6pt;
        font-weight: bold;
        width: 18px;
    }

    .sps-table td.rec-sheet {
        font-size: 5.8pt;
        line-height: 1.1;
    }

    .sps-table td.check-mark {
        font-size: 7pt;
    }

    /* FOOTER */
    .sps-footer-note {
        font-size: 6pt;
        margin-top: 3px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #000;
        padding-top: 2px;
    }

    /* MEDIA PRINT */
    @@media print {
        body {
            background: white !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .no-print, header, nav, footer, .navbar, .sidebar {
            display: none !important;
        }

        .sps-container {
            background: white !important;
            padding: 0 !important;
            margin: 0 !important;
            min-height: auto !important;
        }

        .sps-document {
            width: 100% !important;
            min-height: 100% !important;
            margin: 0 !important;
            padding: 4mm 6mm !important;
            box-shadow: none !important;
            page-break-after: avoid;
            page-break-inside: avoid;
        }

        @@page {
            size: A4 portrait;
            margin: 5mm;
        }
    }
</style>

